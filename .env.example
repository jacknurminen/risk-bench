# Copy this file to .env in the project root.
# Uncomment only the providers you use, and replace the placeholders with your keys.
# Human and random players do not need API keys.

# ANTHROPIC_AALTO_API_KEY=your-anthropic-research-api-key
# OPENAI_API_KEY=your-openai-api-key
# GOOGLE_API_KEY=your-google-api-key

# Output token budgets per call, including provider reasoning tokens.
# MAX_AGENT_TOKENS=8192
# MAX_EVALUATOR_TOKENS=64000
# An Opus 5.5-only evaluator panel can use MAX_EVALUATOR_TOKENS=128000.
