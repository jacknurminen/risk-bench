<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>risk-bench replay</title>
<style>
  :root { --bg:#14151a; --panel:#1d1f26; --line:#2c2f3a; --text:#d8dae2; --dim:#8b8e9c; }
  * { box-sizing: border-box; }
  body { margin:0; background:var(--bg); color:var(--text); font:13px/1.45 system-ui, sans-serif; }
  .layout { display:grid; grid-template-columns: 1fr 340px; grid-template-rows: minmax(0,1fr) auto 230px;
            gap:10px; padding:10px; height:100vh; }
  .panel { background:var(--panel); border:1px solid var(--line); border-radius:8px; padding:10px; overflow:auto; }
  #board { grid-row: 1; display:flex; flex-direction:column; overflow:hidden; position:relative; }
  #continentLegend { position:absolute; left:16px; bottom:32px; background:#14151acc; border:1px solid var(--line);
                     border-radius:6px; padding:5px 8px; font-size:10px; line-height:1.6; }
  #continentLegend .dot { display:inline-block; width:8px; height:8px; border-radius:50%; margin-right:5px;
                          border:1px solid #ffffff44; background:transparent; vertical-align:-1px; }
  #side  { grid-row: 1 / span 2; grid-column: 2; display:flex; flex-direction:column; gap:10px; overflow:hidden; }
  #controls { grid-row: 2; grid-column: 1; display:flex; align-items:center; gap:8px; }
  #log { grid-row: 3; grid-column: 1 / span 2; }
  h3 { margin:2px 0 8px; font-size:12px; text-transform:uppercase; letter-spacing:.08em; color:var(--dim); }
  #board svg { flex:1; min-height:0; width:100%; height:100%; background:#b9cdd9; border-radius:6px; }
  #board .attribution { font-size:10px; color:var(--dim); margin-top:4px; }
  #board .attribution a { color:var(--dim); }
  .acount { font:700 11px system-ui, sans-serif; text-anchor:middle; dominant-baseline:middle;
            fill:#101010; paint-order:stroke; stroke:#ffffffd0; stroke-width:2.5px; pointer-events:none; }
  .tname  { font:400 5px system-ui, sans-serif; text-anchor:middle; dominant-baseline:middle;
            fill:#1f2730; opacity:.85; paint-order:stroke; stroke:#ffffffa8; stroke-width:1.6px;
            pointer-events:none; }
  #board path.flash { animation: borderFlash 1.2s ease-out; }
  @keyframes borderFlash {
    0%   { stroke:#ffe066; stroke-width:4;   stroke-opacity:1; }
    55%  { stroke:#ffe066; stroke-width:2.5; stroke-opacity:1; }
    100% { stroke:#000000; stroke-width:1.2; stroke-opacity:.85; }
  }
  .tlink { border-bottom:1px dotted var(--dim); cursor:pointer; }
  .tlink:hover { border-bottom-color:#ffe066; color:#ffe066; }
  button { background:#2a2d38; color:var(--text); border:1px solid var(--line); border-radius:5px;
           padding:4px 10px; cursor:pointer; font-size:13px; }
  button:hover { background:#343847; }
  input[type=range] { flex:1; }
  #status { min-width:220px; color:var(--dim); }
  .player { border:1px solid var(--line); border-radius:6px; padding:6px 8px; margin-bottom:6px; }
  .player .pname { font-weight:700; }
  .player .mission { color:var(--dim); font-size:11px; margin-top:2px; }
  .player .stats { font-size:11px; margin-top:2px; }
  .player.dead { opacity:.45; }
  .player.acting { outline:2px solid #ffffff33; }
  #chat { flex:1; overflow:auto; }
  .msg { margin-bottom:6px; padding:5px 7px; border-radius:6px; background:#23252e; }
  .msg .meta { font-size:10px; color:var(--dim); }
  .msg.future { opacity:.3; }
  .msg .priv { color:#e0b34c; }
  .entry { padding:2px 6px; border-radius:4px; cursor:pointer; }
  .entry:hover { background:#262935; }
  .entry.current { background:#2e3342; }
  .entry .ev { color:var(--dim); padding-left:14px; }
  .entry .thought { display:none; color:#9d92c5; font-style:italic; padding-left:14px; }
  body.showThoughts .entry .thought { display:block; }
  #log h3 { display:flex; justify-content:space-between; align-items:center; }
  #log h3 label { text-transform:none; letter-spacing:normal; font-weight:400; cursor:pointer; }
  .banner { padding:4px 8px; border-radius:6px; background:#23252e; margin-bottom:8px; }
</style>
</head>
<body>
<div class="layout">
  <div id="board" class="panel">
    {{ board_svg }}
    <div id="continentLegend"></div>
    <div class="attribution">Map: <a href="https://commons.wikimedia.org/wiki/File:Risk_board.svg">Risk board</a>
      by Gr0gmint, Wikimedia Commons, <a href="https://creativecommons.org/licenses/by-sa/3.0">CC BY-SA 3.0</a></div>
  </div>
  <div id="side">
    <div class="panel" id="playersPanel"><h3>Players</h3><div id="players"></div></div>
    <div class="panel" id="chat"><h3>Chat</h3><div id="messages">
      <span id="noMessages" style="color:var(--dim)">No messages.</span>
    </div></div>
  </div>
  <div id="controls" class="panel">
    <button id="first">⏮</button>
    <button id="prevTurn">«turn</button>
    <button id="prev">◀</button>
    <button id="play">▶ play</button>
    <button id="next">▶</button>
    <button id="nextTurn">turn»</button>
    <button id="last">⏭</button>
    <input type="range" id="slider" min="0" value="0">
    <span id="status"></span>
  </div>
  <div id="log" class="panel">
    <h3>Event log <label><input type="checkbox" id="thoughtsToggle"> 🧠 thoughts</label></h3>
    <div id="entries"></div>
  </div>
</div>
<script>
const GAME = {{ game_json }};
const LIVE = {{ live_json }};
const COLORS = ["#c0504d","#4f81bd","#9bbb59","#8064a2","#f79646","#4bacc6"];
const steps = GAME.steps;
let index = 0;
let timer = null;

const el = id => document.getElementById(id);
const pretty = name => name.replaceAll("_", " ");
const escapeHtml = text => text.replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;");

// Player-name highlighting: each player is matched by their full name and, when
// unambiguous, by an informal first token ("gemini-3.5-flash" -> "gemini").
const seatByAlias = {};
{
  const informalTokenCounts = {};
  const informalToken = name => name.split(/[-#.:\s]/)[0].toLowerCase();
  GAME.players.forEach(player => {
    informalTokenCounts[informalToken(player.name)] = (informalTokenCounts[informalToken(player.name)] || 0) + 1;
  });
  GAME.players.forEach((player, seat) => {
    seatByAlias[player.name.toLowerCase()] = seat;
    const informal = informalToken(player.name);
    if (informal && informalTokenCounts[informal] === 1) seatByAlias[informal] = seat;
  });
}
const NAME_PATTERN = new RegExp(
  "\\b(" + Object.keys(seatByAlias)
    .sort((a, b) => b.length - a.length)  // longest first, so the full id wins over its informal token
    .map(alias => alias.replace(/[.*+?^${}()|[\]\\]/g, "\\$&"))
    .join("|") + ")\\b", "gi");

function colorizeNames(text) {
  return escapeHtml(text).replace(NAME_PATTERN, match =>
    `<span style="color:${COLORS[seatByAlias[match.toLowerCase()]]};font-weight:600">${match}</span>`);
}

// Territory and continent mentions become links that flash borders on the map.
const CONTINENT_TERRITORIES = {};
GAME.continents.forEach(continent => CONTINENT_TERRITORIES[continent.name] = continent.territories);
const PLACE_PATTERN = new RegExp(
  "\\b(" + [...Object.keys(steps[0].board), ...GAME.continents.map(continent => continent.name)]
    .sort((a, b) => b.length - a.length).join("|") + ")\\b", "g");

function richText(text) {
  return colorizeNames(text).replace(PLACE_PATTERN, match =>
    `<span class="tlink" data-place="${match}">${match}</span>`);
}

function flashTerritory(territory) {
  const path = territoryShapes[territory].path;
  path.classList.remove("flash");
  void path.getBoundingClientRect();  // force a reflow so re-adding the class restarts the animation
  path.classList.add("flash");
}

const CONTINENT_OF = {};
GAME.continents.forEach(continent => continent.territories.forEach(t => CONTINENT_OF[t] = continent.name));

function flashPlace(place) {
  for (const territory of CONTINENT_TERRITORIES[place] ?? [place]) flashTerritory(territory);
}

document.addEventListener("click", event => {
  const link = event.target.closest(".tlink");
  if (link) flashPlace(link.dataset.place);
});

const SVG_NS = "http://www.w3.org/2000/svg";
const territoryShapes = {};

function buildBoard() {
  const svg = document.querySelector("#board svg");
  for (const territory of Object.keys(steps[0].board)) {
    const path = svg.getElementById(territory);
    const box = path.getBBox();
    const centerX = box.x + box.width / 2, centerY = box.y + box.height / 2;
    // getBBox is in the path's local coordinates: the labels must live in the same
    // (transformed) layer group as the path, not at the svg root
    const label = document.createElementNS(SVG_NS, "text");
    label.setAttribute("x", centerX);
    label.setAttribute("y", centerY);
    label.setAttribute("class", "acount");
    path.parentNode.appendChild(label);
    const nameLabel = document.createElementNS(SVG_NS, "text");
    nameLabel.setAttribute("x", centerX);
    nameLabel.setAttribute("y", centerY + 8);
    nameLabel.setAttribute("class", "tname");
    nameLabel.textContent = pretty(territory);
    path.parentNode.appendChild(nameLabel);
    const tooltip = document.createElementNS(SVG_NS, "title");
    path.appendChild(tooltip);
    territoryShapes[territory] = { path, label, tooltip };
  }
}

function buildContinentLegend() {
  const container = el("continentLegend");
  GAME.continents.forEach((continent, i) => {
    const row = document.createElement("div");
    row.innerHTML = `<span class="dot" id="cl-${i}"></span>` +
      `<span class="tlink" data-place="${continent.name}">${pretty(continent.name)}</span> +${continent.bonus}`;
    container.appendChild(row);
  });
}

function updateContinentLegend(step) {
  GAME.continents.forEach((continent, i) => {
    const seats = new Set(continent.territories.map(territory => step.board[territory][0]));
    const controller = seats.size === 1 ? [...seats][0] : null;
    const dot = el("cl-" + i);
    dot.style.background = controller === null ? "transparent" : COLORS[controller];
    dot.title = controller === null ? "contested" : GAME.players[controller].name;
  });
}

function buildPlayers() {
  const container = el("players");
  GAME.players.forEach((player, seat) => {
    const card = document.createElement("div");
    card.className = "player";
    card.id = "p-" + seat;
    card.innerHTML = `<div class="pname" style="color:${COLORS[seat]}">${player.name}</div>
      <div class="mission">${player.mission}</div><div class="stats"></div>`;
    container.appendChild(card);
  });
  updateResultBanner();
}

function updateResultBanner() {
  if (!GAME.result || el("resultBanner")) return;
  const banner = document.createElement("div");
  banner.className = "banner";
  banner.id = "resultBanner";
  banner.textContent = GAME.result.winner
    ? `Winner: ${GAME.result.winner} (turn ${GAME.result.turn_count})`
    : `Draw at the turn limit (turn ${GAME.result.turn_count})`;
  el("players").prepend(banner);
}

function appendChat(fromIndex) {
  const container = el("messages");
  if (GAME.messages.length > fromIndex) el("noMessages")?.remove();
  for (let i = fromIndex; i < GAME.messages.length; i++) {
    const message = GAME.messages[i];
    const div = document.createElement("div");
    div.className = "msg";
    div.id = "m-" + i;
    const channel = message.visibility === "private"
      ? `<span class="priv">🔒 to ${colorizeNames(message.recipient)}</span>` : "to everyone";
    div.innerHTML = `<div class="meta">turn ${message.turn_number} — ${colorizeNames(message.sender)} ${channel}</div>
      <div>${richText(message.text)}</div>`;
    container.appendChild(div);
  }
  if (LIVE && GAME.messages.length > fromIndex) el("chat").scrollTop = el("chat").scrollHeight;
}

function upsertLogEntry(i) {
  const step = steps[i];
  let entry = document.getElementById("e-" + i);
  if (!entry) {
    entry = document.createElement("div");
    entry.className = "entry";
    entry.id = "e-" + i;
    entry.onclick = () => show(i);
    el("entries").appendChild(entry);
  }
  const events = step.events.map(text => `<div class="ev">${richText(text)}</div>`).join("");
  const thoughts = GAME.thoughts.filter(thought => thought.step === i)
    .map(thought => `<div class="thought">🧠 ${colorizeNames(thought.player)}: ${richText(thought.text)}</div>`)
    .join("");
  entry.innerHTML = `<div>${i === 0 ? "Game start: territories dealt" : richText(step.action)}</div>${events}${thoughts}`;
}

function appendLog(fromIndex) {
  for (let i = fromIndex; i < steps.length; i++) upsertLogEntry(i);
}

function show(newIndex) {
  index = Math.max(0, Math.min(steps.length - 1, newIndex));
  const step = steps[index];
  for (const [territory, [seat, armies]] of Object.entries(step.board)) {
    const shape = territoryShapes[territory];
    shape.path.style.fill = COLORS[seat];
    shape.path.style.fillOpacity = "0.78";
    shape.label.textContent = armies;
    shape.tooltip.textContent =
      `${pretty(territory)} (${pretty(CONTINENT_OF[territory])}) — ${GAME.players[seat].name}, ${armies} armies`;
  }
  step.players.forEach((stats, seat) => {
    const card = el("p-" + seat);
    card.classList.toggle("dead", stats.eliminated);
    card.classList.toggle("acting", GAME.players[seat].name === step.current_player);
    card.querySelector(".stats").textContent =
      `${stats.territories} territories · ${stats.armies} armies · ${stats.cards} cards · +${stats.income}/turn`;
  });
  updateContinentLegend(step);
  GAME.messages.forEach((message, i) => el("m-" + i).classList.toggle("future", message.step > index));
  document.querySelectorAll(".entry.current").forEach(entry => entry.classList.remove("current"));
  const entry = el("e-" + index);
  entry.classList.add("current");
  entry.scrollIntoView({ block: "nearest" });
  el("slider").value = index;
  const liveMark = LIVE && !GAME.result ? " — LIVE" : "";
  el("status").textContent = `step ${index}/${steps.length - 1} — turn ${step.turn}, ${pretty(step.phase)}${liveMark}`;
}

function stopPlaying() { clearInterval(timer); timer = null; el("play").textContent = "▶ play"; }
function turnBoundary(direction) {
  const turn = steps[index].turn;
  let i = index;
  while (i + direction >= 0 && i + direction < steps.length && steps[i = i + direction].turn === turn);
  return i;
}

el("first").onclick = () => show(0);
el("last").onclick = () => show(steps.length - 1);
el("prev").onclick = () => show(index - 1);
el("next").onclick = () => show(index + 1);
el("prevTurn").onclick = () => show(turnBoundary(-1));
el("nextTurn").onclick = () => show(turnBoundary(1));
el("slider").max = steps.length - 1;
el("slider").oninput = event => show(Number(event.target.value));
el("play").onclick = () => {
  if (timer) { stopPlaying(); return; }
  el("play").textContent = "⏸ pause";
  timer = setInterval(() => { if (index >= steps.length - 1) stopPlaying(); else show(index + 1); }, 250);
};
document.addEventListener("keydown", event => {
  if (event.key === "ArrowLeft") show(index - 1);
  if (event.key === "ArrowRight") show(index + 1);
});
el("thoughtsToggle").onchange = event => document.body.classList.toggle("showThoughts", event.target.checked);

let lastFingerprint = null;
async function refreshFromJournal() {
  const response = await fetch("game.json", { cache: "no-store" });
  if (!response.ok) return;
  const updated = await response.json();
  // the last known step can gain events after the fact (the journal writes them
  // on a separate line), so the fingerprint covers it, not just the counts
  const fingerprint = JSON.stringify(
    [updated.steps.length, updated.steps.at(-1), updated.messages.length, updated.thoughts.length, updated.result]);
  if (fingerprint === lastFingerprint) return;
  lastFingerprint = fingerprint;

  const wasFollowingLatest = index === steps.length - 1;
  const knownSteps = steps.length, knownMessages = GAME.messages.length;
  steps.splice(0, steps.length, ...updated.steps);
  GAME.messages.splice(0, GAME.messages.length, ...updated.messages);
  GAME.thoughts.splice(0, GAME.thoughts.length, ...updated.thoughts);
  GAME.result = updated.result;
  appendLog(Math.max(0, knownSteps - 1));
  appendChat(knownMessages);
  updateResultBanner();
  el("slider").max = steps.length - 1;
  show(wasFollowingLatest ? steps.length - 1 : index);
}

buildBoard(); buildContinentLegend(); buildPlayers(); appendChat(0); appendLog(0); show(LIVE ? steps.length - 1 : 0);
if (LIVE) setInterval(refreshFromJournal, 1000);
</script>
</body>
</html>
