<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>risk-bench · evaluation reader</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,400;0,500;0,600;1,400&family=IBM+Plex+Sans:wght@400;500;600;700&family=Source+Serif+4:opsz,wght@8..60,400;8..60,500;8..60,600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/theme.css">
<link rel="stylesheet" href="/assets/reader/reader.css">
</head>
<body>
<header class="masthead">
  <div class="inner">
    <div><span class="brand">risk-bench</span><small>evaluation reader</small></div>
    <div class="mastmeta">
      <span id="mastStatus"></span>
      <span style="color:#c7c1b3">·</span>
      <span id="mastWinner"></span>
      <button class="btn" id="gameControl" style="display:none;font-size:10px;padding:4px 10px">⏸ pause game</button>
      {% if human_url %}<button class="btn" id="humanControl" style="display:none;font-size:10px;padding:4px 10px">Your move</button>{% endif %}
      <button class="btn" id="exportBtn" onclick="toggleExport()" style="font-size:10px;padding:4px 10px">✂ export</button>
      <button class="btn" onclick="openStats()" style="font-size:10px;padding:4px 10px">📊 stats</button>
    </div>
  </div>
</header>

<div class="shell">
  <aside class="rail">
    <div class="section">
      <div class="railHead"><span class="eyebrow">Players</span><span class="railHint">✓ = shown in feed</span></div>
      <button class="toggle missionToggle" id="missionToggle" type="button" role="switch" aria-checked="false" hidden>
        <span class="switch" aria-hidden="true"><span class="knob"></span></span>
        <span>Hide opponent missions</span>
      </button>
      <div id="railPlayers"></div>
    </div>
    <div class="card filters">
      <div id="axisSection">
        <div class="flabel">Behaviour axis</div>
        <div class="axisrow" id="axisRow"></div>
      </div>
      <div class="flabel">Min confidence</div>
      <div class="seg" id="confSeg"></div>
      <div class="flabel">Annotators</div>
      <div id="annList" style="display:flex;flex-direction:column;gap:5px;margin-bottom:16px"></div>
      <div class="toggle" id="privToggle" style="margin-top:0"><span class="switch"><span class="knob"></span></span>
        <span class="mono" style="font-size:11.5px">Private layers (thoughts · notes)</span></div>
      <div class="toggle" id="commToggle"><span class="switch"><span class="knob"></span></span>
        <span class="mono" style="font-size:11.5px">Live commentary</span></div>
    </div>
  </aside>

  <main class="feed">
    <section class="card boardcard">
      <div class="boardhead"><span class="eyebrow" id="boardTurnLabel">Board</span>
        <div class="boardTools"><span id="boardHint"></span>
          <button class="btn" id="mapZoomOut" type="button" aria-label="Zoom out map">−</button>
          <button class="btn" id="mapZoomReset" type="button" title="Reset map view">100%</button>
          <button class="btn" id="mapZoomIn" type="button" aria-label="Zoom in map">+</button>
          <button class="btn" id="mapFocus" type="button" aria-pressed="false">Focus map</button></div></div>
      <div id="board">{{ board_svg }}<div id="continentLegend"></div>
        <div class="attribution">Map: <a href="https://commons.wikimedia.org/wiki/File:Risk_board.svg">Risk board</a>
          by Gr0gmint, Wikimedia Commons, <a href="https://creativecommons.org/licenses/by-sa/3.0">CC BY-SA 3.0</a></div>
      </div>
      <div class="controls">
        <button class="cbtn" id="first" title="first">⏮</button>
        <button class="cbtn" id="prevTurn" title="previous turn">«turn</button>
        <button class="cbtn" id="prev" title="step back">◀</button>
        <button class="cbtn" id="play">▶ play</button>
        <button class="cbtn" id="next" title="step forward">▶</button>
        <button class="cbtn" id="nextTurn" title="next turn">turn»</button>
        <button class="cbtn" id="last" title="last">⏭</button>
        <input type="range" id="slider" min="0" value="0">
        <span id="status"></span>
      </div>
      <div class="statstrip" id="statStrip"></div>
    </section>

    <div id="mapDivider" role="separator" tabindex="0" aria-label="Resize map and timeline"
      aria-orientation="horizontal" aria-controls="board timelinePane"
      title="Drag to resize · arrow keys to adjust · double-click to reset"><span></span></div>
    <section id="timelinePane" aria-label="Timeline and game analysis" tabindex="0">
    {% if human_url %}
    <section class="card humanTurn" id="humanTurn" hidden aria-labelledby="humanTitle">
      <div class="notesHead"><span class="serif" id="humanTitle">Your turn</span><span class="mono humanContext" id="humanContext"></span></div>
      <p id="humanHint" aria-live="polite"></p><p id="humanHelp"></p>
      <div id="humanLiveNotice" hidden><span>Return to the live board to continue your turn. Your draft is saved.</span>
        <button class="btn" id="humanGoLive" type="button">Return to live board</button></div>
      <div id="humanResult" aria-live="polite"></div>
      <form id="humanForm"><fieldset id="humanFields">
        <label id="humanNotesLabel" hidden>Your private notes<textarea id="humanNotes" rows="10" maxlength="8000" placeholder="Record agreements, mission suspicions, and plans for later turns."></textarea></label>
        <div id="humanActions">
          <label id="humanModeLabel">Action<select id="humanKind"></select></label>
          <div id="humanPlacement" hidden>
            <div class="humanPlanHead"><strong id="humanProgress"></strong><div>
              <button class="btn" id="humanUndo" type="button">Undo last change</button>
              <button class="btn" id="humanClear" type="button">Clear placements</button></div></div>
            <div class="humanAdd"><label>Add to territory<select id="humanPlaceTerritory"></select></label>
              <button class="btn" id="humanAddOne" type="button">Add one</button>
              <button class="btn" id="humanAddRemaining" type="button">Add remaining</button></div>
            <div id="humanAllocations"></div>
          </div>
          <div id="humanPair" hidden>
            <div class="humanColumns"><label>From<select id="humanSource"></select></label>
              <label>To<select id="humanTarget"></select></label></div>
            <p id="humanPairSummary"></p>
            <div id="humanAttack" class="humanColumns" hidden>
              <label>Attack dice<input id="humanDice" type="number" min="1" max="3" value="1"></label>
              <label>Armies to leave behind<input id="humanLeave" type="number" min="1" value="1"></label>
              <label>Maximum rolls<input id="humanRolls" type="number" min="1" value="3"></label>
            </div>
            <div id="humanFortify" hidden><label>Armies to move<input id="humanMoveSlider" type="range" min="1" value="1"></label>
              <div class="humanMoveCount"><button class="btn" id="humanMoveMinus" type="button" aria-label="Move one fewer army">−</button>
                <label>Count<input id="humanMoveCount" type="number" min="1" value="1"></label>
                <button class="btn" id="humanMovePlus" type="button" aria-label="Move one more army">+</button></div></div>
          </div>
          <label id="humanTradeLabel" hidden>Card set<select id="humanTrade"></select></label>
        </div>
        <details class="humanHand"><summary>Your mission &amp; cards</summary><p id="humanMission"></p><p id="humanCards"></p></details>
        <label id="humanMessageLabel">Message (optional)<textarea id="humanMessage" rows="2" maxlength="4000" placeholder="Say something to the table"></textarea></label>
        <label id="humanRecipientLabel">Send to<select id="humanRecipient"></select></label>
        <details class="humanReasoning" id="humanReasoning"><summary>Private reasoning (optional)</summary><label>Saved for analysis<textarea id="humanThought" rows="2" maxlength="8000"></textarea></label></details>
        <div class="humanFooter"><button class="btn" id="humanSkipNotes" type="button" hidden>Continue without changes</button>
          <button class="btn" id="humanEnd" type="button" hidden>Finish attacking</button>
          <button class="btn" id="humanRepeat" type="button" hidden>Attack repeatedly</button>
          <button class="btn dark" id="humanSubmit" type="submit">Confirm move</button></div>
      </fieldset></form><p id="humanError" role="alert"></p>
    </section>
    {% endif %}

    <details class="readerAnalysis" id="readerAnalysis" open>
    <summary>Game analysis</summary>
    <section class="card evalBar" id="evalBar" hidden></section>
    <section class="card ctaCard" id="evalCta" hidden></section>
    <section class="card" id="synthSection" style="padding:16px 18px;margin-bottom:14px" hidden></section>

    </details>

    <div class="subbar">
      <div><span class="count" id="turnCount"></span><span class="sub" id="subStat"></span></div>
      <div style="display:flex;align-items:center;gap:6px">
        <span class="modeToggle" id="modeToggle"></span>
        <button class="btn" id="expandAll">expand</button>
        <button class="btn" id="collapseAll">collapse</button>
      </div>
    </div>

    <div id="timeline"></div>
    </section>
  </main>
  {% if human_url %}
  <aside class="humanSide" id="humanSide" hidden aria-label="Human player controls">
    <div class="card humanWaiting" id="humanWaiting" role="status">Agents are playing. Your controls will appear here when needed.</div>
  </aside>
  {% endif %}
</div>

<div id="panelRoot"></div>
<div id="statsModal" onclick="if(event.target===this)closeStats()">
  <div class="card statsBox">
    <div class="statsHead">
      <span class="serif" style="font-size:17px;font-weight:600">📊 Game statistics</span>
      <span class="modeToggle" id="statsTabs">
        <button id="tabOverview" class="on" onclick="showStatsSheet('overview')">overview</button><button id="tabEval" onclick="showStatsSheet('evaluation')">evaluation</button><button id="tabCalls" onclick="showStatsSheet('calls')">API calls</button>
      </span>
      <button class="iconbtn" onclick="closeStats()" style="font-size:18px;color:var(--mute-2)">✕</button>
    </div>
    <div id="overviewSheet">
      <div id="statsLegend"></div>
      <div id="charts"></div>
      <div id="commentaryStats">
        <div id="memberToggles"></div>
        <div id="agreementFilter"></div>
        <div id="valenceCharts"></div>
      </div>
      <div id="tokenSection">
        <div class="eyebrow">per turn — input (left bar) / output (right bar), stacked</div>
        <div class="tokenControls">
          <label>measure
            <select id="tokMeasure"><option value="tokens">tokens</option><option value="cost">cost ($)</option></select></label>
          <label>breakdown
            <select id="tokBreakdown"><option value="all">all (by call type)</option><option value="model">by model</option></select></label>
        </div>
        <div id="tokenChart"></div>
      </div>
      <div id="tagFilterNote"></div>
      <table id="statsTable"></table>
      <div id="usageNote">Costs are estimated from list prices per token; unknown models show no cost.</div>
    </div>
    <div id="evalSheet" hidden></div>
    <div id="callsSheet" hidden>
      <div style="display:flex;gap:12px;align-items:center;margin:10px 0">
        <label class="mono" style="font-size:11px;color:var(--mute)">source <select id="callSource" style="font-family:var(--font-mono);font-size:11px;padding:3px 6px;border:1px solid var(--line);border-radius:5px;background:#fff"><option value="game">game</option><option value="evaluation">evaluator panel</option></select></label>
        <label class="mono" style="font-size:11px;color:var(--mute)">caller <select id="callerFilter" style="font-family:var(--font-mono);font-size:11px;padding:3px 6px;border:1px solid var(--line);border-radius:5px;background:#fff"></select></label>
        <span id="callsStatus" class="mono" style="font-size:11px;color:var(--mute-2)"></span>
      </div>
      <div id="callsList"></div>
    </div>
  </div>
</div>
<div class="chartTip" id="chartTip"></div>
<div id="notesModal" onclick="if(event.target===this)closeNotes()">
  <div class="card notesBox">
    <div class="notesHead"><span class="serif" id="notesTitle" style="font-size:16px;font-weight:600"></span>
      <button class="iconbtn" onclick="closeNotes()" style="font-size:18px;color:var(--mute-2)">✕</button></div>
    <div id="notesBody"></div>
  </div>
</div>
<div id="exportModal" onclick="if(event.target===this)backToSelecting()">
  <div class="card exportBox">
    <div class="notesHead"><span class="serif" style="font-size:16px;font-weight:600">✂ Export as image</span>
      <button class="iconbtn" onclick="backToSelecting()" style="font-size:18px;color:var(--mute-2)">✕</button></div>
    <div class="mono" id="exportMeta" style="font-size:11px;color:var(--mute-2);margin-bottom:10px"></div>
    <input id="exportName" spellcheck="false" placeholder="file name">
    <div style="display:flex;gap:8px;justify-content:flex-end;margin-top:14px">
      <button class="btn" onclick="backToSelecting()">back to selecting</button>
      <button class="btn dark" id="exportSave" onclick="saveExport()">Save PNG</button>
    </div>
  </div>
</div>

<div class="toast" id="toast"></div>

<script>
window.BOOT = {
  game: {{ game_json }},
  evaluation: {{ eval_json }},
  live: {{ live_json }},
  live_running: {{ live_running_json }},
  urls: {
    poll: {{ poll_url_json }},
    evaluation_poll: {{ eval_poll_url_json }},
    evaluate: {{ evaluate_url_json }},
    verifications: {{ verifications_url_json }},
    trace: {{ trace_url_json }},
    analysis: {{ analysis_url_json }},
    human: {{ human_url_json }},
  },
};
</script>
<script src="/assets/reader/state.js"></script>
<script src="/assets/reader/board.js"></script>
<script src="/assets/reader/timeline.js"></script>
<script src="/assets/reader/drawer.js"></script>
<script src="/assets/reader/evaluate.js"></script>
<script src="/assets/reader/shell.js"></script>
<script src="/assets/reader/stats.js"></script>
<script src="/assets/reader/evalstats.js"></script>
<script src="/assets/reader/export.js"></script>
<script src="/assets/reader/main.js"></script>
<script src="/assets/reader/layout.js"></script>
{% if human_url %}<script src="/assets/reader/human-draft.js"></script>
<script src="/assets/reader/human.js"></script>{% endif %}
</body>
</html>
