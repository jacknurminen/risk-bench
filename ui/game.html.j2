<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>risk-bench replay</title>
<style>
  :root { --bg:#f6f6f4; --panel:#ffffff; --line:#e3e2de; --ink:#1f2329; --dim:#6e747d; --accent:#44546a;
          --sans: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif; }
  * { box-sizing: border-box; }
  body { margin:0; background:var(--bg); color:var(--ink); font:13px/1.5 var(--sans); }
  .layout { display:grid; grid-template-columns: 300px 1fr 340px; grid-template-rows: minmax(0,1fr) auto 230px;
            gap:10px; padding:10px; height:100vh; }
  .panel { background:var(--panel); border:1px solid var(--line); border-radius:6px; padding:10px; overflow:auto; }
  #board { grid-row: 1; grid-column: 2; display:flex; flex-direction:column; overflow:hidden; position:relative; }
  #continentLegend { position:absolute; left:16px; bottom:32px; background:#ffffffe8; border:1px solid var(--line);
                     border-radius:5px; padding:5px 8px; font-size:10px; line-height:1.6; }
  #continentLegend .dot { display:inline-block; width:8px; height:8px; border-radius:50%; margin-right:5px;
                          border:1px solid #00000026; background:transparent; vertical-align:-1px; }
  #side  { grid-row: 1 / span 2; grid-column: 3; display:flex; flex-direction:column; gap:10px; overflow:hidden; }
  #controls { grid-row: 2; grid-column: 2; display:flex; align-items:center; gap:8px; }
  #log { grid-row: 3; grid-column: 1 / span 3; }
  #commentaryPanel { grid-row: 1 / span 2; grid-column: 1; }
  .comm { margin-bottom:7px; padding:6px 8px; background:#f3f6f9; border-left:3px solid var(--accent);
          border-radius:3px; cursor:pointer; }
  .comm .meta { font-size:10px; color:var(--dim); text-transform:uppercase; letter-spacing:.06em; }
  .comm.future { opacity:.35; }
  .comm .tag { display:inline-block; font-size:10px; color:var(--accent); background:#e8ecf1;
               border:1px solid #d4dae2; border-radius:3px; padding:0 5px; margin:2px 3px 0 0; }
  .comm .tag.positive, #statsTable .tag.positive { color:#2e6b34; background:#e6efe4; border-color:#cfdfce; }
  .comm .tag.negative, #statsTable .tag.negative { color:#a33f3b; background:#f7e9e7; border-color:#e8d3d0; }
  .comm .tag.deceptive, #statsTable .tag.deceptive { color:#8a5a1f; background:#f6eede; border-color:#e6d6b8; }
  .comm .rubric { font-size:9px; text-transform:uppercase; letter-spacing:.08em; color:var(--dim); }
  h3 { margin:2px 0 8px; font:600 11px var(--sans); text-transform:uppercase; letter-spacing:.1em;
       color:var(--dim); border-bottom:1px solid var(--line); padding-bottom:4px; }
  #board svg { flex:1; min-height:0; width:100%; height:100%; background:#ccdae3; border-radius:4px;
               border:1px solid var(--line); }
  #board .attribution { font-size:10px; color:var(--dim); margin-top:4px; }
  #board .attribution a { color:var(--dim); }
  .acount { font:700 11px system-ui, sans-serif; text-anchor:middle; dominant-baseline:middle;
            fill:#101010; paint-order:stroke; stroke:#ffffffd0; stroke-width:2.5px; pointer-events:none; }
  .tname  { font:400 5px system-ui, sans-serif; text-anchor:middle; dominant-baseline:middle;
            fill:#2c3540; opacity:.85; paint-order:stroke; stroke:#ffffffa8; stroke-width:1.6px;
            pointer-events:none; }
  #board path.flash { animation: borderFlash 1.2s ease-out; }
  @keyframes borderFlash {
    0%   { stroke:#c45d12; stroke-width:4;   stroke-opacity:1; }
    55%  { stroke:#c45d12; stroke-width:2.5; stroke-opacity:1; }
    100% { stroke:#000000; stroke-width:1.2; stroke-opacity:.85; }
  }
  .tlink { border-bottom:1px dotted #b3b1aa; cursor:pointer; }
  .tlink:hover { border-bottom-color:var(--accent); color:var(--accent); }
  button { background:var(--panel); color:var(--ink); border:1px solid #c6c5c0; border-radius:5px;
           padding:4px 10px; cursor:pointer; font:13px var(--sans); }
  button:hover { background:#f0efec; }
  input[type=range] { flex:1; accent-color:var(--accent); }
  #status { min-width:220px; color:var(--dim); font-size:12px; }
  .player { border:1px solid var(--line); background:#fff; border-radius:5px; padding:6px 8px; margin-bottom:6px; }
  .player .pname { font-weight:700; }
  .player .mission { color:var(--dim); font-size:11px; margin-top:2px; font-style:italic; }
  .player .stats { font-size:11px; margin-top:2px; }
  .player.dead { opacity:.45; }
  .player.acting { outline:2px solid #44546a40; }
  #chat { flex:1; overflow:auto; }
  .msg { margin-bottom:6px; padding:5px 7px; border-radius:4px; background:#f3f3f1; border:1px solid #e8e7e3; }
  .msg .meta { font-size:10px; color:var(--dim); }
  .msg.future { opacity:.35; }
  .msg .priv { color:#9a7b1f; }
  .entry { padding:2px 6px; border-radius:4px; cursor:pointer; }
  .entry:hover { background:#f0efec; }
  .entry.current { background:#e7eaee; }
  .entry .ev { color:var(--dim); padding-left:14px; }
  .entry .thought { display:none; color:#6a5a96; font-style:italic; padding-left:14px; }
  body.showThoughts .entry .thought { display:block; }
  #log h3 { display:flex; justify-content:space-between; align-items:center; }
  #log h3 label { text-transform:none; letter-spacing:normal; font-weight:400; cursor:pointer; }
  .banner { padding:4px 8px; border-radius:4px; background:#f0efec; border:1px solid var(--line);
            margin-bottom:8px; }
  #statsModal { position:fixed; inset:0; background:#1f232955; display:flex; align-items:center;
                justify-content:center; z-index:10; }
  #statsModal[hidden] { display:none; }
  #statsBox { width:min(1080px, 94vw); max-height:92vh; overflow:auto; padding:16px 20px; }
  #statsBox h3 { display:flex; justify-content:space-between; align-items:center; }
  #statsLegend span { margin-right:12px; font-weight:600; }
  #statsLegend .markerKey { color:var(--dim); font-weight:400; float:right; }
  #charts { display:grid; grid-template-columns:1fr 1fr; gap:14px; margin-top:10px; }
  .chart h4 { margin:0 0 4px; font:600 10px var(--sans); text-transform:uppercase; letter-spacing:.08em;
              color:var(--dim); }
  .chart svg { width:100%; height:auto; background:#fcfcfb; border:1px solid var(--line); border-radius:4px; }
  .chart text.axis { font:9px var(--sans); fill:var(--dim); }
  .chart text.marker { font:8px var(--sans); cursor:default; }
  #statsTable { width:100%; border-collapse:collapse; margin-top:16px; font-size:12px; }
  #statsTable th { text-align:left; color:var(--dim); font-weight:600; font-size:10px; text-transform:uppercase;
                   letter-spacing:.07em; padding:4px 8px; border-bottom:1.5px solid #c9c8c3; }
  #statsTable td { padding:5px 8px; border-bottom:1px solid var(--line); vertical-align:top; }
  #statsTable .tag { display:inline-block; font-size:10px; color:var(--accent); background:#e8ecf1;
                     border:1px solid #d4dae2; border-radius:3px; padding:0 5px; margin:1px 3px 1px 0; }
  #usageNote { color:var(--dim); font-size:11px; margin-top:6px; }
  #statsTabs { margin-left:auto; margin-right:12px; }
  .tab { padding:3px 12px; font-size:12px; border-radius:0; }
  .tab:first-child { border-radius:5px 0 0 5px; }
  .tab:last-child { border-radius:0 5px 5px 0; margin-left:-1px; }
  .tab.active { background:var(--accent); color:#fff; border-color:var(--accent); }
  .call { border-bottom:1px solid var(--line); }
  .callrow { padding:5px 6px; cursor:pointer; font-size:12px; }
  .callrow:hover { background:#f0efec; }
  .call.failed .callrow { background:#fbeeec; }
  .callrow .callerr { color:#b02a1f; }
  .calldetail { padding:4px 8px 10px; background:#fafaf8; border-top:1px dashed var(--line); }
  .calldetail .m { margin:7px 0; }
  .calldetail .role { font-size:10px; text-transform:uppercase; letter-spacing:.07em; color:var(--dim);
                      font-weight:600; }
  .calldetail pre { margin:2px 0; padding:6px 8px; background:#fff; border:1px solid var(--line);
                    border-radius:4px; white-space:pre-wrap; word-break:break-word; max-height:300px;
                    overflow:auto; font-size:11px; }
  .calldetail .m.system pre { border-left:3px solid var(--accent); }
  .calldetail .mtool { font:11px ui-monospace, "SF Mono", Menlo, Consolas, monospace; color:#4a5a3f;
                       padding:2px 0 2px 10px; word-break:break-all; }
  .calldetail details summary { cursor:pointer; color:var(--dim); font-size:11px; margin-top:6px; }
  .empty { color:var(--dim); padding:10px 4px; }
</style>
</head>
<body>
<div class="layout">
  <div id="board" class="panel">
    {{ board_svg }}
    <div id="continentLegend"></div>
    <div class="attribution">Map: <a href="https://commons.wikimedia.org/wiki/File:Risk_board.svg">Risk board</a>
      by Gr0gmint, Wikimedia Commons, <a href="https://creativecommons.org/licenses/by-sa/3.0">CC BY-SA 3.0</a></div>
  </div>
  <div id="side">
    <div class="panel" id="playersPanel"><h3>Players</h3><div id="players"></div></div>
    <div class="panel" id="chat"><h3>Chat</h3><div id="messages">
      <span id="noMessages" style="color:var(--dim)">No messages.</span>
    </div></div>
  </div>
  <div id="controls" class="panel">
    <button id="first">⏮</button>
    <button id="prevTurn">«turn</button>
    <button id="prev">◀</button>
    <button id="play">▶ play</button>
    <button id="next">▶</button>
    <button id="nextTurn">turn»</button>
    <button id="last">⏭</button>
    <button id="statsButton">📊 stats</button>
    <input type="range" id="slider" min="0" value="0">
    <span id="status"></span>
  </div>
  <div id="log" class="panel">
    <h3>Event log <label><input type="checkbox" id="thoughtsToggle"> 🧠 thoughts</label></h3>
    <div id="entries"></div>
  </div>
  <div id="commentaryPanel" class="panel">
    <h3>🎙️ Commentary</h3>
    <div id="commentaryFeed">
      <span id="noCommentary" style="color:var(--dim)">No commentary in this journal.
        Run the game with --commentator &lt;model spec&gt; to get one.</span>
    </div>
  </div>
</div>
<div id="statsModal" hidden>
  <div id="statsBox" class="panel">
    <h3>📊 Game statistics
      <span id="statsTabs">
        <button id="tabOverview" class="tab active">overview</button><button id="tabCalls" class="tab">API calls</button>
      </span>
      <button id="statsClose">✕ close</button></h3>
    <div id="overviewSheet">
      <div id="statsLegend"></div>
      <div id="charts"></div>
      <table id="statsTable"></table>
      <div id="usageNote">Costs are estimated from list prices per token; unknown models show no cost.</div>
    </div>
    <div id="callsSheet" hidden>
      <div class="row" style="margin:8px 0">
        <label>caller <select id="callerFilter"></select></label>
        <span id="callsStatus" style="color:var(--dim)"></span>
      </div>
      <div id="callsList"></div>
    </div>
  </div>
</div>
<script>
const GAME = {{ game_json }};
const LIVE = {{ live_json }};
const POLL_URL = {{ poll_url_json }};
const TRACE_URL = {{ trace_url_json }};
const COLORS = ["#a33f3b","#3c6c9e","#6e8f3a","#6b5288","#c97a29","#2f8a9e"];
const steps = GAME.steps;
let index = 0;
let timer = null;

const el = id => document.getElementById(id);
const pretty = name => name.replaceAll("_", " ");
const escapeHtml = text => text.replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;");

// Player-name highlighting: each player is matched by their full name and, when
// unambiguous, by an informal first token ("gemini-3.5-flash" -> "gemini").
const seatByAlias = {};
{
  const informalTokenCounts = {};
  const informalToken = name => name.split(/[-#.:\s]/)[0].toLowerCase();
  GAME.players.forEach(player => {
    informalTokenCounts[informalToken(player.name)] = (informalTokenCounts[informalToken(player.name)] || 0) + 1;
  });
  GAME.players.forEach((player, seat) => {
    seatByAlias[player.name.toLowerCase()] = seat;
    const informal = informalToken(player.name);
    if (informal && informalTokenCounts[informal] === 1) seatByAlias[informal] = seat;
  });
}
const NAME_PATTERN = new RegExp(
  "\\b(" + Object.keys(seatByAlias)
    .sort((a, b) => b.length - a.length)  // longest first, so the full id wins over its informal token
    .map(alias => alias.replace(/[.*+?^${}()|[\]\\]/g, "\\$&"))
    .join("|") + ")\\b", "gi");

function colorizeNames(text) {
  return escapeHtml(text).replace(NAME_PATTERN, match =>
    `<span style="color:${COLORS[seatByAlias[match.toLowerCase()]]};font-weight:600">${match}</span>`);
}

// Territory and continent mentions become links that flash borders on the map.
const CONTINENT_TERRITORIES = {};
GAME.continents.forEach(continent => CONTINENT_TERRITORIES[continent.name] = continent.territories);
const PLACE_PATTERN = new RegExp(
  "\\b(" + [...Object.keys(steps[0].board), ...GAME.continents.map(continent => continent.name)]
    .sort((a, b) => b.length - a.length).join("|") + ")\\b", "g");

function richText(text) {
  return colorizeNames(text).replace(PLACE_PATTERN, match =>
    `<span class="tlink" data-place="${match}">${match}</span>`);
}

function flashTerritory(territory) {
  const path = territoryShapes[territory].path;
  path.classList.remove("flash");
  void path.getBoundingClientRect();  // force a reflow so re-adding the class restarts the animation
  path.classList.add("flash");
}

const CONTINENT_OF = {};
GAME.continents.forEach(continent => continent.territories.forEach(t => CONTINENT_OF[t] = continent.name));

function flashPlace(place) {
  for (const territory of CONTINENT_TERRITORIES[place] ?? [place]) flashTerritory(territory);
}

document.addEventListener("click", event => {
  const link = event.target.closest(".tlink");
  if (link) flashPlace(link.dataset.place);
});

const SVG_NS = "http://www.w3.org/2000/svg";
const territoryShapes = {};

function buildBoard() {
  const svg = document.querySelector("#board svg");
  for (const territory of Object.keys(steps[0].board)) {
    const path = svg.getElementById(territory);
    const box = path.getBBox();
    const centerX = box.x + box.width / 2, centerY = box.y + box.height / 2;
    // getBBox is in the path's local coordinates: the labels must live in the same
    // (transformed) layer group as the path, not at the svg root
    const label = document.createElementNS(SVG_NS, "text");
    label.setAttribute("x", centerX);
    label.setAttribute("y", centerY);
    label.setAttribute("class", "acount");
    path.parentNode.appendChild(label);
    const nameLabel = document.createElementNS(SVG_NS, "text");
    nameLabel.setAttribute("x", centerX);
    nameLabel.setAttribute("y", centerY + 8);
    nameLabel.setAttribute("class", "tname");
    nameLabel.textContent = pretty(territory);
    path.parentNode.appendChild(nameLabel);
    const tooltip = document.createElementNS(SVG_NS, "title");
    path.appendChild(tooltip);
    territoryShapes[territory] = { path, label, tooltip };
  }
}

function buildContinentLegend() {
  const container = el("continentLegend");
  GAME.continents.forEach((continent, i) => {
    const row = document.createElement("div");
    row.innerHTML = `<span class="dot" id="cl-${i}"></span>` +
      `<span class="tlink" data-place="${continent.name}">${pretty(continent.name)}</span> +${continent.bonus}`;
    container.appendChild(row);
  });
}

function updateContinentLegend(step) {
  GAME.continents.forEach((continent, i) => {
    const seats = new Set(continent.territories.map(territory => step.board[territory][0]));
    const controller = seats.size === 1 ? [...seats][0] : null;
    const dot = el("cl-" + i);
    dot.style.background = controller === null ? "transparent" : COLORS[controller];
    dot.title = controller === null ? "contested" : GAME.players[controller].name;
  });
}

function buildPlayers() {
  const container = el("players");
  GAME.players.forEach((player, seat) => {
    const card = document.createElement("div");
    card.className = "player";
    card.id = "p-" + seat;
    card.innerHTML = `<div class="pname" style="color:${COLORS[seat]}">${player.name}</div>
      <div class="mission">${player.mission}</div><div class="stats"></div>`;
    container.appendChild(card);
  });
  updateResultBanner();
}

function updateResultBanner() {
  if (!GAME.result || el("resultBanner")) return;
  const banner = document.createElement("div");
  banner.className = "banner";
  banner.id = "resultBanner";
  banner.textContent = GAME.result.winner
    ? `Winner: ${GAME.result.winner} (turn ${GAME.result.turn_count})`
    : `Draw at the turn limit (turn ${GAME.result.turn_count})`;
  el("players").prepend(banner);
}

function appendChat(fromIndex) {
  const container = el("messages");
  if (GAME.messages.length > fromIndex) el("noMessages")?.remove();
  for (let i = fromIndex; i < GAME.messages.length; i++) {
    const message = GAME.messages[i];
    const div = document.createElement("div");
    div.className = "msg";
    div.id = "m-" + i;
    const channel = message.visibility === "private"
      ? `<span class="priv">🔒 to ${colorizeNames(message.recipient)}</span>` : "to everyone";
    div.innerHTML = `<div class="meta">turn ${message.turn_number} — ${colorizeNames(message.sender)} ${channel}</div>
      <div>${richText(message.text)}</div>`;
    container.appendChild(div);
  }
  if (LIVE && GAME.messages.length > fromIndex) el("chat").scrollTop = el("chat").scrollHeight;
}

function upsertLogEntry(i) {
  const step = steps[i];
  let entry = document.getElementById("e-" + i);
  if (!entry) {
    entry = document.createElement("div");
    entry.className = "entry";
    entry.id = "e-" + i;
    entry.onclick = () => show(i);
    el("entries").appendChild(entry);
  }
  const events = step.events.map(text => `<div class="ev">${richText(text)}</div>`).join("");
  const thoughts = GAME.thoughts.filter(thought => thought.step === i)
    .map(thought => `<div class="thought">🧠 ${colorizeNames(thought.player)}: ${richText(thought.text)}</div>`)
    .join("");
  entry.innerHTML =
    `<div>${i === 0 ? "Game start: territories dealt" : richText(step.action)}</div>${events}${thoughts}`;
}

function appendCommentary(fromIndex) {
  const container = el("commentaryFeed");
  if (GAME.commentary.length > fromIndex) el("noCommentary")?.remove();
  for (let i = fromIndex; i < GAME.commentary.length; i++) {
    const comment = GAME.commentary[i];
    const div = document.createElement("div");
    div.className = "comm";
    div.id = "c-" + i;
    const tags = comment.tags
      .map(tag => `<span class="tag${valenceClass(tag.behavior)}" title="${escapeHtml(tag.note)}">` +
        `${tag.behavior}: ${colorizeNames(tag.player)}</span>`)
      .join("");
    const rubric = comment.rubric ? ` <span class="rubric">${comment.rubric}</span>` : "";
    div.innerHTML = `<div class="meta">turn ${comment.turn}${rubric}</div><div>${richText(comment.text)}</div>` +
      (tags ? `<div>${tags}</div>` : "");
    div.onclick = () => show(comment.step);
    container.appendChild(div);
  }
  if (LIVE && GAME.commentary.length > fromIndex) {
    el("commentaryPanel").scrollTop = el("commentaryPanel").scrollHeight;
  }
}

function appendLog(fromIndex) {
  for (let i = fromIndex; i < steps.length; i++) upsertLogEntry(i);
}

function show(newIndex) {
  index = Math.max(0, Math.min(steps.length - 1, newIndex));
  const step = steps[index];
  for (const [territory, [seat, armies]] of Object.entries(step.board)) {
    const shape = territoryShapes[territory];
    shape.path.style.fill = COLORS[seat];
    shape.path.style.fillOpacity = "0.78";
    shape.label.textContent = armies;
    shape.tooltip.textContent =
      `${pretty(territory)} (${pretty(CONTINENT_OF[territory])}) — ${GAME.players[seat].name}, ${armies} armies`;
  }
  step.players.forEach((stats, seat) => {
    const card = el("p-" + seat);
    card.classList.toggle("dead", stats.eliminated);
    card.classList.toggle("acting", GAME.players[seat].name === step.current_player);
    card.querySelector(".stats").textContent =
      `${stats.territories} territories · ${stats.armies} armies · ${stats.cards} cards · +${stats.income}/turn`;
  });
  updateContinentLegend(step);
  GAME.messages.forEach((message, i) => el("m-" + i).classList.toggle("future", message.step > index));
  GAME.commentary.forEach((comment, i) => el("c-" + i).classList.toggle("future", comment.step > index));
  document.querySelectorAll(".entry.current").forEach(entry => entry.classList.remove("current"));
  const entry = el("e-" + index);
  entry.classList.add("current");
  entry.scrollIntoView({ block: "nearest" });
  el("slider").value = index;
  const liveMark = LIVE && !GAME.result ? " — LIVE" : "";
  el("status").textContent = `step ${index}/${steps.length - 1} — turn ${step.turn}, ${pretty(step.phase)}${liveMark}`;
}

// Stats modal: hand-rolled SVG line charts (per-turn series computed in Python
// from the replay, so the page never re-derives game rules) plus a per-player table.
const MARKER_GLYPHS = { elimination: "✕", continent: "◆", trade: "▲" };

function renderStats() {
  el("statsLegend").innerHTML = GAME.players
    .map((player, seat) => `<span style="color:${COLORS[seat]}">${player.name}</span>`).join("")
    + '<span class="markerKey">✕ elimination &nbsp;◆ continent control &nbsp;▲ card trade</span>';
  const seriesByPlayer = GAME.stats.series.players;
  const charts = el("charts");
  charts.innerHTML = "";
  charts.appendChild(buildChart("army share", seriesByPlayer.map(s => s.army_share), v => Math.round(v * 100) + "%"));
  charts.appendChild(buildChart("territories", seriesByPlayer.map(s => s.territories), v => Math.round(v)));
  charts.appendChild(buildChart("income per turn", seriesByPlayer.map(s => s.income), v => Math.round(v)));
  charts.appendChild(buildChart("cards in hand", seriesByPlayer.map(s => s.cards), v => Math.round(v)));
  if (GAME.commentary.length) {
    charts.appendChild(
      buildChart("skill: strong play, cumulative", seriesByPlayer.map(s => s.skill_strong), v => Math.round(v)));
    charts.appendChild(
      buildChart("skill: weak play, cumulative", seriesByPlayer.map(s => s.skill_weak), v => Math.round(v)));
    charts.appendChild(
      buildChart("conduct: cooperative, cumulative", seriesByPlayer.map(s => s.conduct_cooperative), v => Math.round(v)));
    charts.appendChild(
      buildChart("conduct: adversarial, cumulative", seriesByPlayer.map(s => s.conduct_adversarial), v => Math.round(v)));
    charts.appendChild(
      buildChart("conduct: deception, cumulative", seriesByPlayer.map(s => s.conduct_deceptive), v => Math.round(v)));
  }
  renderStatsTable();
}

function buildChart(title, valuesBySeat, formatValue) {
  const W = 470, H = 230, PAD = { left: 38, right: 12, top: 26, bottom: 18 };
  const turns = GAME.stats.series.turns;
  // integer-valued charts round the axis up to an even maximum so the midpoint label is exact
  const dataMax = Math.max(...valuesBySeat.flat()) || 1;
  const yMax = valuesBySeat.flat().every(Number.isInteger) ? Math.max(2, Math.ceil(dataMax / 2) * 2) : dataMax;
  const xAt = i => PAD.left + (turns.length < 2 ? 0 : i * (W - PAD.left - PAD.right) / (turns.length - 1));
  const yAt = v => H - PAD.bottom - (v / yMax) * (H - PAD.top - PAD.bottom);
  const parts = [];

  for (const fraction of [0, 0.5, 1]) {
    const gy = yAt(yMax * fraction);
    parts.push(`<line x1="${PAD.left}" y1="${gy}" x2="${W - PAD.right}" y2="${gy}" stroke="#e8e7e3"/>`);
    parts.push(`<text x="${PAD.left - 4}" y="${gy + 3}" class="axis" text-anchor="end">${formatValue(yMax * fraction)}</text>`);
  }
  parts.push(`<text x="${PAD.left}" y="${H - 4}" class="axis">turn ${turns[0]}</text>`);
  parts.push(`<text x="${W - PAD.right}" y="${H - 4}" class="axis" text-anchor="end">turn ${turns.at(-1)}</text>`);

  const markersByTurn = {};
  for (const marker of GAME.stats.markers) (markersByTurn[marker.turn] ??= []).push(marker);
  for (const [turn, markers] of Object.entries(markersByTurn)) {
    const turnIndex = turns.indexOf(Number(turn));
    if (turnIndex < 0) continue;
    const mx = xAt(turnIndex);
    parts.push(`<line x1="${mx}" y1="${PAD.top - 6}" x2="${mx}" y2="${H - PAD.bottom}"
      stroke="#c9c8c3" stroke-dasharray="3 3"/>`);
    markers.forEach((marker, level) => {
      const seat = GAME.players.findIndex(player => player.name === marker.player);
      parts.push(`<text x="${mx}" y="${10 + level * 10}" class="marker" text-anchor="middle"
        fill="${COLORS[seat] ?? "#888"}">${MARKER_GLYPHS[marker.kind] ?? "•"}
        <title>turn ${turn}: ${escapeHtml(marker.text)}</title></text>`);
    });
  }

  valuesBySeat.forEach((values, seat) => {
    const points = values.map((value, i) => `${xAt(i)},${yAt(value)}`).join(" ");
    parts.push(`<polyline points="${points}" fill="none" stroke="${COLORS[seat]}" stroke-width="1.6"/>`);
    if (turns.length <= 40) values.forEach((value, i) =>
      parts.push(`<circle cx="${xAt(i)}" cy="${yAt(value)}" r="2" fill="${COLORS[seat]}"/>`));
  });

  const chart = document.createElement("div");
  chart.className = "chart";
  chart.innerHTML = `<h4>${title}</h4><svg viewBox="0 0 ${W} ${H}">${parts.join("")}</svg>`;
  return chart;
}

// Chips are tinted by the behavior's valence: strong play and cooperative conduct read
// "positive", weak play and adversarial conduct "negative", deception its own colour.
// Descriptive affect tags (valence null) keep the default chip style.
const valenceClass = behavior =>
  ({
    strong: " positive", cooperative: " positive",
    weak: " negative", adversarial: " negative",
    deceptive: " deceptive",
  })[(GAME.stats.tag_valence ?? {})[behavior]] ?? "";

function usageCells(caller) {
  const usage = (GAME.stats.usage ?? {})[caller];
  if (!usage) return "<td>—</td><td>—</td><td>—</td>";
  const failed = usage.errors ? ` <span class="callerr">(${usage.errors} failed)</span>` : "";
  const cost = usage.cost_usd == null ? "—" : `$${usage.cost_usd.toFixed(2)}`;
  return `<td>${usage.calls}${failed}</td>
    <td>${usage.input_tokens.toLocaleString("en-US")} / ${usage.output_tokens.toLocaleString("en-US")}</td>
    <td>${cost}</td>`;
}

function renderStatsTable() {
  const rows = GAME.players.map((player, seat) => {
    const stats = GAME.stats.per_player[seat];
    const tags = Object.entries(stats.tags).sort((a, b) => b[1] - a[1])
      .map(([behavior, count]) =>
        `<span class="tag${valenceClass(behavior)}">${behavior}${count > 1 ? ` ×${count}` : ""}</span>`).join("");
    return `<tr><td style="color:${COLORS[seat]};font-weight:700">${player.name}</td>
      <td>${stats.attacks}</td><td>${stats.conquests}</td>
      <td>${stats.armies_destroyed} / ${stats.armies_lost}</td>
      <td>${stats.public_messages} 📢 &nbsp;${stats.private_messages} 🔒</td>
      ${usageCells(player.name)}
      <td>${tags || "—"}</td></tr>`;
  });
  if ((GAME.stats.usage ?? {}).commentator) {
    rows.push(`<tr><td style="color:var(--dim);font-weight:700">🎙️ commentator</td>
      <td>—</td><td>—</td><td>—</td><td>—</td>${usageCells("commentator")}<td>—</td></tr>`);
  }
  el("statsTable").innerHTML = `<thead><tr><th>player</th><th>attacks</th><th>conquests</th>
    <th>armies destroyed / lost</th><th>messages</th>
    <th>api calls</th><th>tokens in / out</th><th>est. cost</th>
    <th>behavior tags</th></tr></thead>
    <tbody>${rows.join("")}</tbody>`;
}

// The API calls sheet: summaries come from the server's trace endpoint; the full
// prompt/response of a call is fetched lazily when it is expanded.
let traceCalls = null;

function showStatsSheet(name) {
  el("overviewSheet").hidden = name !== "overview";
  el("callsSheet").hidden = name !== "calls";
  el("tabOverview").classList.toggle("active", name === "overview");
  el("tabCalls").classList.toggle("active", name === "calls");
  if (name === "calls") loadCalls();
}

async function loadCalls() {
  const container = el("callsList");
  if (!TRACE_URL) {
    el("callsStatus").textContent = "";
    container.innerHTML = '<div class="empty">The API trace is only available when the game is served by the' +
      ' web app; this static export does not include it.</div>';
    return;
  }
  el("callsStatus").textContent = "loading…";
  const response = await fetch(TRACE_URL, { cache: "no-store" });
  if (!response.ok) { el("callsStatus").textContent = "could not load the trace"; return; }
  traceCalls = (await response.json()).calls;
  el("callsStatus").textContent = traceCalls.length
    ? `${traceCalls.length} calls` : "no API calls recorded for this game";
  const callers = [...new Set(traceCalls.map(call => call.caller))];
  const selected = el("callerFilter").value;
  el("callerFilter").innerHTML = '<option value="">all</option>' +
    callers.map(caller => `<option${caller === selected ? " selected" : ""}>${caller}</option>`).join("");
  renderCalls();
}

function renderCalls() {
  const filter = el("callerFilter").value;
  const rows = (traceCalls ?? []).filter(call => !filter || call.caller === filter).map(call => {
    const outcome = call.error ? `<span class="callerr">✗ ${escapeHtml(call.error)}</span>`
      : call.tool_call_names.length ? `→ ${call.tool_call_names.join(", ")}` : "→ text only";
    const tokens = call.input_tokens == null ? ""
      : `${call.input_tokens.toLocaleString("en-US")} → ${call.output_tokens.toLocaleString("en-US")} tok · `;
    return `<div class="call${call.error ? " failed" : ""}">
      <div class="callrow" onclick="toggleCallDetail(${call.seq})">
        <span class="meta">#${call.seq} · turn ${call.turn} · ${call.kind} · </span>${colorizeNames(call.caller)}
        <span class="meta"> · ${call.message_count} messages · ${tokens}${call.latency_ms} ms</span> ${outcome}
      </div>
      <div class="calldetail" id="detail-${call.seq}" hidden></div>
    </div>`;
  });
  el("callsList").innerHTML = rows.join("") || '<div class="empty">No calls match the filter.</div>';
}

async function toggleCallDetail(seq) {
  const detail = el("detail-" + seq);
  if (!detail.hidden) { detail.hidden = true; return; }
  if (!detail.innerHTML) {
    detail.innerHTML = '<div class="empty">loading…</div>';
    const record = await (await fetch(`${TRACE_URL}/${seq}`)).json();
    detail.innerHTML = renderCallDetail(record);
  }
  detail.hidden = false;
}

function renderCallDetail(record) {
  const toolCallLines = calls => (calls ?? [])
    .map(call => `<div class="mtool">⚙ ${call.name}(${escapeHtml(JSON.stringify(call.arguments))})</div>`).join("");
  const messages = record.messages.map(message =>
    `<div class="m ${message.role}">
      <span class="role">${message.role}${message.tool_call_id ? ` · result for ${message.tool_call_id}` : ""}</span>
      ${message.content ? `<pre>${escapeHtml(message.content)}</pre>` : ""}${toolCallLines(message.tool_calls)}
    </div>`).join("");
  const response = record.response
    ? `<div class="m"><span class="role">⬅ response</span>
        ${record.response.text ? `<pre>${escapeHtml(record.response.text)}</pre>` : ""}
        ${toolCallLines(record.response.tool_calls)}</div>`
    : `<div class="m"><span class="role">⬅ error</span><pre>${escapeHtml(record.error ?? "")}</pre></div>`;
  const tools = record.tools.length
    ? `<details><summary>${record.tools.length} tools offered (schemas)</summary>
        <pre>${escapeHtml(JSON.stringify(record.tools, null, 2))}</pre></details>` : "";
  return messages + response + tools;
}

el("tabOverview").onclick = () => showStatsSheet("overview");
el("tabCalls").onclick = () => showStatsSheet("calls");
el("callerFilter").onchange = renderCalls;

el("statsButton").onclick = () => {
  renderStats();
  if (!el("callsSheet").hidden) loadCalls();
  el("statsModal").hidden = false;
};
el("statsClose").onclick = () => el("statsModal").hidden = true;
el("statsModal").onclick = event => { if (event.target === el("statsModal")) el("statsModal").hidden = true; };

function stopPlaying() { clearInterval(timer); timer = null; el("play").textContent = "▶ play"; }
function turnBoundary(direction) {
  const turn = steps[index].turn;
  let i = index;
  while (i + direction >= 0 && i + direction < steps.length && steps[i = i + direction].turn === turn);
  return i;
}

el("first").onclick = () => show(0);
el("last").onclick = () => show(steps.length - 1);
el("prev").onclick = () => show(index - 1);
el("next").onclick = () => show(index + 1);
el("prevTurn").onclick = () => show(turnBoundary(-1));
el("nextTurn").onclick = () => show(turnBoundary(1));
el("slider").max = steps.length - 1;
el("slider").oninput = event => show(Number(event.target.value));
el("play").onclick = () => {
  if (timer) { stopPlaying(); return; }
  el("play").textContent = "⏸ pause";
  timer = setInterval(() => { if (index >= steps.length - 1) stopPlaying(); else show(index + 1); }, 250);
};
document.addEventListener("keydown", event => {
  if (event.key === "Escape") el("statsModal").hidden = true;
  if (event.key === "ArrowLeft") show(index - 1);
  if (event.key === "ArrowRight") show(index + 1);
});
el("thoughtsToggle").onchange = event => document.body.classList.toggle("showThoughts", event.target.checked);

let lastFingerprint = null;
async function refreshFromJournal() {
  const response = await fetch(POLL_URL, { cache: "no-store" });
  if (!response.ok) return;
  const updated = await response.json();
  // the last known step can gain events after the fact (the journal writes them
  // on a separate line), so the fingerprint covers it, not just the counts
  const fingerprint = JSON.stringify([
    updated.steps.length, updated.steps.at(-1),
    updated.messages.length, updated.thoughts.length, updated.commentary.length, updated.result,
  ]);
  if (fingerprint === lastFingerprint) return;
  lastFingerprint = fingerprint;

  const wasFollowingLatest = index === steps.length - 1;
  const knownSteps = steps.length, knownMessages = GAME.messages.length, knownCommentary = GAME.commentary.length;
  steps.splice(0, steps.length, ...updated.steps);
  GAME.messages.splice(0, GAME.messages.length, ...updated.messages);
  GAME.thoughts.splice(0, GAME.thoughts.length, ...updated.thoughts);
  GAME.commentary.splice(0, GAME.commentary.length, ...updated.commentary);
  GAME.result = updated.result;
  GAME.stats = updated.stats;
  if (!el("statsModal").hidden) renderStats();
  appendLog(Math.max(0, knownSteps - 1));
  appendChat(knownMessages);
  appendCommentary(knownCommentary);
  updateResultBanner();
  el("slider").max = steps.length - 1;
  show(wasFollowingLatest ? steps.length - 1 : index);
}

buildBoard(); buildContinentLegend(); buildPlayers();
appendChat(0); appendLog(0); appendCommentary(0);
show(LIVE ? steps.length - 1 : 0);
if (LIVE) setInterval(refreshFromJournal, 1000);
</script>
</body>
</html>
