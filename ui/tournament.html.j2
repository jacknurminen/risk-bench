<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>risk-bench · tournament</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,400;0,500;0,600;1,400&family=IBM+Plex+Sans:wght@400;500;600;700&family=Source+Serif+4:opsz,wght@8..60,400;8..60,500;8..60,600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/theme.css">
<link rel="stylesheet" href="/assets/research-report.css">
<style>
  body { padding-bottom: 60px; }

  /* masthead */
  .masthead { position: sticky; top: 0; z-index: 40; background: rgba(244,243,239,.92); backdrop-filter: blur(10px);
              border-bottom: 1px solid var(--line-3); }
  .masthead .inner { max-width: 1100px; margin: 0 auto; padding: 13px 30px; display: flex; align-items: baseline;
                     justify-content: space-between; gap: 24px; flex-wrap: wrap; }
  .brand { font-family: var(--font-serif); font-weight: 600; font-size: 22px; letter-spacing: -.01em; }
  .brand .dice { color: var(--gold); }
  .brand small { font-family: var(--font-mono); font-size: 11px; color: var(--mute-2); font-weight: 400; margin-left: 12px; }
  .mastmeta { display: flex; align-items: center; gap: 16px; font-family: var(--font-mono); font-size: 11px; color: var(--mute); }
  .mastmeta a { color: var(--mute); text-decoration: underline; }

  .shell { max-width: 1100px; margin: 0 auto; padding: 26px 30px 0; }
  .section { margin-bottom: 30px; }
  .section > .eyebrow { margin: 0 2px 9px; }

  /* player legend */
  #legend { display: flex; gap: 16px; flex-wrap: wrap; margin: 0 2px 22px; }
  #legend .key { display: inline-flex; align-items: center; gap: 6px; font-family: var(--font-mono);
                 font-size: 11px; color: var(--body); }

  /* tables */
  .tableCard { padding: 6px 14px; overflow: auto; }
  .tournamentTabs { display: flex; gap: 8px; margin-bottom: 20px; }
  .tournamentTabs button { padding: 9px 16px; border: 1px solid var(--line); border-radius: 6px; background: white; cursor: pointer; }
  .tournamentTabs button[aria-pressed="true"] { background: var(--ink); color: white; }
  table { width: 100%; border-collapse: collapse; }
  th { text-align: left; font-family: var(--font-mono); font-weight: 500; font-size: 9.5px; text-transform: uppercase;
       letter-spacing: .12em; color: var(--mute-2); padding: 10px 10px 7px; border-bottom: 1px solid var(--line); }
  td { padding: 9px 10px; border-bottom: 1px solid var(--line-2); font-size: 12.5px; vertical-align: top; }
  td.num { font-family: var(--font-mono); font-size: 11px; color: var(--body); white-space: nowrap; }
  tr.game { cursor: pointer; }
  tr.game:hover td { background: var(--subtle); }
  tr:last-child td { border-bottom: none; }
  .status { font-family: var(--font-mono); font-size: 9px; letter-spacing: .06em; text-transform: uppercase;
            padding: 2px 8px; border-radius: 999px; white-space: nowrap; display: inline-block; }
  .status.live { background: var(--coop-tint); color: var(--coop); animation: runningPulse 1.4s ease-in-out infinite; }
  @keyframes runningPulse { 50% { opacity: .45; } }
  .status.done { background: var(--neutral-tint); color: var(--neutral); }
  .winner { font-family: var(--font-mono); font-size: 11.5px; color: var(--coop); font-weight: 600; }

  /* explanatory notes + controls */
  .note { color: var(--mute); font-size: 12px; line-height: 1.6; margin: 0 0 12px; max-width: 880px; }
  .controls { display: flex; flex-wrap: wrap; gap: 16px; margin: 0 0 14px; font-family: var(--font-mono);
              font-size: 11px; color: var(--mute); align-items: center; }
  .controls label { display: inline-flex; align-items: center; gap: 6px; cursor: pointer; user-select: none; }
  .controls input[type=checkbox] { accent-color: var(--ink); }
  .controls label[hidden] { display: none; }
  .controls label:has(input:disabled) { opacity: .5; cursor: not-allowed; }
  select { background: #fff; color: var(--ink); border: 1px solid var(--line); border-radius: 5px;
           padding: 4px 7px; font: 11px var(--font-mono); }
  #tournamentEvalVersion { max-width: min(620px, 65vw); }
  #tournamentEvalError, #tournamentContinueError, #tournamentReplayError { color: var(--attack, #a33f3b); }
  #tournamentReplayGame { max-width: min(560px, 75vw); }
  #tournamentAdditionalGames { width: 80px; padding: 5px 8px; }

  /* charts */
  #charts, #agreementCharts { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .chart { background: var(--card); border: 1px solid var(--line); border-radius: 8px; padding: 12px 14px 10px; }
  .chart h4 { margin: 0 0 8px; font-family: var(--font-mono); font-weight: 500; font-size: 10px;
              text-transform: uppercase; letter-spacing: .12em; color: var(--mute-2); }
  .chart svg { width: 100%; height: auto; display: block; }
  .chart text.axis { font: 9px var(--font-mono); fill: var(--mute-2); }
  #agreementLegend { display: inline-flex; gap: 10px; align-items: center; }
  #agreementLegend span.swatch { display: inline-block; width: 9px; height: 9px; border-radius: 2px;
                                 margin-right: 3px; vertical-align: -1px; }
  .tokenLegend { font-family: var(--font-mono); font-size: 10.5px; color: var(--mute); margin: 0 0 8px; }
  .tokenLegend span { font-weight: 700; }

  /* behaviour tag chips in the aggregate table */
  .tag { display: inline-block; font-family: var(--font-mono); font-size: 10px; color: #7a6f5c;
         background: #efeade; border-radius: 3px; padding: 1px 6px; margin: 1px 3px 1px 0; }
</style>
</head>
<body>
<header class="masthead">
  <div class="inner">
    <div class="brand"><span class="dice">⚂</span> risk-bench<small>tournament · <span id="tournamentId"></span></small></div>
    <div class="mastmeta"><span id="liveNote"></span><a href="/">← all games</a></div>
  </div>
</header>
<div class="shell">
  <section class="card section" style="padding:16px" aria-label="Continue tournament">
    <form id="tournamentContinueForm">
      <div class="controls"><strong>Continue tournament</strong>
        <label>Additional games <input id="tournamentAdditionalGames" type="number" min="1" max="1000" step="1" value="5" required></label>
        <button class="btn" id="tournamentContinueRun" type="submit">Add games</button></div>
      <p class="note" id="tournamentContinueHint"></p>
      <p id="tournamentContinueStatus" role="status"></p>
      <p id="tournamentContinueError" role="alert"></p>
    </form>
    <details>
      <summary>Replay a tournament game</summary>
      <form id="tournamentReplayForm" style="margin-top:14px">
        <div class="controls"><label>Game <select id="tournamentReplayGame"></select></label>
          <button class="btn" id="tournamentReplayRun" type="submit">Replay from start</button></div>
        <p class="note" id="tournamentReplayHint"></p>
        <p id="tournamentReplayStatus" role="status"></p>
        <p id="tournamentReplayError" role="alert"></p>
      </form>
      <details id="tournamentReplayHistory" hidden></details>
    </details>
  </section>
  <nav class="tournamentTabs" aria-label="Tournament panels">
    <button id="researchTab" aria-pressed="true" onclick="showTournamentPanel('research')">Research evaluation</button>
    <button id="contextTab" aria-pressed="false" onclick="showTournamentPanel('context')">Game context &amp; API usage</button>
  </nav>
  <section id="tournamentEvalControls" class="card section" style="padding:16px">
    <div class="controls"><label>Evaluation version <select id="tournamentEvalVersion"></select></label>
      <span id="tournamentEvalStatus" role="status"></span></div>
    <details><summary>Configure tournament evaluations</summary>
      <div class="controls" style="margin-top:14px"><label>Method <select id="tournamentEvalMethod">
        <option value="whole_game">Whole game</option><option value="live_rounds">Replay rounds</option>
      </select></label></div>
      <div id="tournamentEvalRows"></div>
      <div class="controls"><button class="btn" id="tournamentEvalAdd" disabled>Add evaluator</button>
        <button class="btn" id="tournamentEvalRun" disabled>Rerun all evaluations</button></div>
      <p class="note" id="tournamentEvalHint"></p>
    </details>
    <p id="tournamentEvalError" role="alert"></p>
    <details id="tournamentEvalJobs" hidden></details>
  </section>
  <section id="tournamentResearch" aria-label="Research evaluation"></section>
  <div id="tournamentContext" hidden>
  <div id="legend"></div>
  <details id="seatingSchedule" class="section" hidden>
    <summary>Configured seating schedule</summary>
    <div class="card tableCard"><table id="seatingTable"></table></div>
  </details>

  <div class="section">
    <div class="eyebrow">games</div>
    <div class="card tableCard"><table id="gamesTable"></table></div>
  </div>

  <div class="section">
    <div class="eyebrow">cross-game statistics</div>
    <div class="note">Bold line: mean across the games still running at each turn. Shaded band: 95% bootstrap
      confidence interval for that mean — how well the average is pinned down; it widens late-game as games
      finish and fewer remain. Dashed lines: the parametric 95% Student-t interval for the same mean, an
      alternative to the bootstrap band kept for side-by-side comparison (it can run wider than the data at
      very small samples). Dotted lines: the min–max envelope, i.e. the extreme games at each turn (a spread,
      not a confidence statement). Thin lines: the individual games. The win-rate intervals in the table
      below are Wilson 95% score intervals, valid at any sample size.</div>
    <div class="controls">
      <label><input type="checkbox" id="toggleCi" checked> 95% bootstrap band</label>
      <label><input type="checkbox" id="toggleT"> 95% t-interval</label>
      <label><input type="checkbox" id="toggleMinMax"> min–max envelope</label>
      <label><input type="checkbox" id="toggleGames" checked> individual games</label>
    </div>
    <div id="charts"></div>
  </div>

  <div class="section">
    <div class="eyebrow">api usage per turn</div>
    <div class="note">Mean per turn across the games. Each turn shows two bars: input (the prompt sent) on the
      left, output (the model's response) on the right. Switch between token counts and estimated cost, and
      between stacking by call type or by model.</div>
    <div class="controls">
      <label>measure
        <select id="tokMeasure"><option value="tokens">tokens</option><option value="cost">cost ($)</option></select></label>
      <label>breakdown
        <select id="tokBreakdown"><option value="all">all (by call type)</option><option value="model">by model</option></select></label>
    </div>
    <div id="tokenChart"></div>
  </div>

  <div class="section">
    <div class="eyebrow">aggregates across all games</div>
    <div class="card tableCard"><table id="aggregateTable"></table></div>
  </div>
</div>
</div>
<script src="/assets/research-report.js"></script>
<script src="/assets/tournament-evaluate.js"></script>
<script src="/assets/tournament-continue.js"></script>
<script src="/assets/tournament-replay.js"></script>
<script>
const DATA = {{ tournament_json }};
const LIVE = {{ live_json }};
const POLL_URL = {{ poll_url_json }};
const COLORS = ["#a33f3b","#3670ab","#6e8f3a","#71509c","#c97a29","#1f92ab"];
const GRID = "#efece2";
const el = id => document.getElementById(id);
const escapeHtml = text => text.replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;");

const METRICS = [
  ["army share", "army_share", v => Math.round(v * 100) + "%"],
  ["territories", "territories", v => Math.round(v)],
  ["income per turn", "income", v => Math.round(v)],
  ["cards in hand", "cards", v => Math.round(v)],
];

let latestData = null;

function render(data) {
  latestData = data;
  renderTournamentEvaluations(data);
  renderTournamentContinuation(data);
  renderTournamentReplay(data);
  el("tournamentId").textContent = data.id;
  el("liveNote").textContent = data.games.length === (data.total_games ?? data.games.length) && data.games.every(game => game.finished)
    ? `${data.games.length} games, all finished` : `${data.games.length}/${data.total_games ?? data.games.length} games started · ${data.parallel_games ?? "—"} at once — updating`;
  el("legend").innerHTML = data.players
    .map((name, seat) => `<span class="key"><span class="swatch" style="background:${COLORS[seat]}"></span>${escapeHtml(name)}</span>`).join("");
  renderGamesTable(data);
  const schedule = data.seating_schedule || [];
  el("seatingSchedule").hidden = !schedule.length;
  el("seatingTable").innerHTML = `<thead><tr><th>game</th><th>seed</th><th>seats, first to last</th></tr></thead><tbody>` +
    schedule.map((row, i) => `<tr><td>${i + 1}</td><td>${row.seed}</td><td>${row.players
      .map((player, j) => `Player ${row.order[j]}: ${escapeHtml(player)}`).join(" → ")}</td></tr>`).join("") + "</tbody>";
  drawCharts();
  const openDetails = new Set([...el("tournamentResearch").querySelectorAll("details[open]")]
    .map(d => d.querySelector("summary")?.textContent));
  el("tournamentResearch").innerHTML = renderTournamentResearch(data.research, data.games, data.output_volume);
  el("tournamentResearch").querySelectorAll("details").forEach(d => {
    if (openDetails.has(d.querySelector("summary")?.textContent)) d.open = true;
  });
  renderTokenChart();
  renderAggregateTable(data);
}

function showTournamentPanel(name) {
  el("tournamentEvalControls").hidden = name !== "research";
  el("tournamentResearch").hidden = name !== "research";
  el("tournamentContext").hidden = name !== "context";
  el("researchTab").setAttribute("aria-pressed", String(name === "research"));
  el("contextTab").setAttribute("aria-pressed", String(name === "context"));
}

function drawCharts() {
  if (!latestData) return;
  const show = {
    confidenceBand: el("toggleCi").checked,
    tInterval: el("toggleT").checked,
    minMaxEnvelope: el("toggleMinMax").checked,
    individualGames: el("toggleGames").checked,
  };
  const charts = el("charts");
  charts.innerHTML = "";
  if (!latestData.turns.length) {
    charts.innerHTML = '<p class="note">Waiting for recorded gameplay from the current attempts.</p>';
    return;
  }
  for (const [title, metric, formatValue] of METRICS) {
    charts.appendChild(buildChart(latestData, title, metric, formatValue, show));
  }
}

for (const toggleId of ["toggleCi", "toggleT", "toggleMinMax", "toggleGames"]) {
  el(toggleId).addEventListener("change", drawCharts);
}

function renderGamesTable(data) {
  const rows = data.games.map(game => {
    const status = game.finished
      ? '<span class="status done">finished</span>' : '<span class="status live">● in progress</span>';
    const winner = game.winner ? `<span class="winner">${game.winner}</span>` : (game.finished ? "draw" : "—");
    const cost = game.cost_usd == null ? "—" : `$${game.cost_usd.toFixed(2)}`;
    return `<tr class="game" onclick="location.href='/games/${game.id}'">
      <td class="num">${game.id}</td><td class="num">seed ${game.seed}</td><td>${status}</td>
      <td>${winner}</td><td class="num">${game.turn_count}</td><td class="num">${cost}</td></tr>`;
  });
  el("gamesTable").innerHTML = `<thead><tr><th>game</th><th>seed</th><th>status</th><th>winner</th>
    <th>turn</th><th>est. cost</th></tr></thead><tbody>${rows.join("")}</tbody>`;
}

function buildChart(data, title, metric, formatValue, show) {
  const W = 470, H = 240, PAD = { left: 38, right: 12, top: 14, bottom: 18 };
  const turns = data.turns;
  const perSeat = data.metrics[metric];
  const dataMax = Math.max(...perSeat.map(seat => Math.max(...seat.max))) || 1;
  const integerValued = perSeat.every(seat => seat.games.flat().every(Number.isInteger));
  const yMax = integerValued ? Math.max(2, Math.ceil(dataMax / 2) * 2) : dataMax;
  const xAt = i => PAD.left + (turns.length < 2 ? 0 : i * (W - PAD.left - PAD.right) / (turns.length - 1));
  const yAt = v => H - PAD.bottom - (v / yMax) * (H - PAD.top - PAD.bottom);
  const parts = [];

  for (const fraction of [0, 0.5, 1]) {
    const gy = yAt(yMax * fraction);
    parts.push(`<line x1="${PAD.left}" y1="${gy}" x2="${W - PAD.right}" y2="${gy}" stroke="${GRID}"/>`);
    parts.push(`<text x="${PAD.left - 4}" y="${gy + 3}" class="axis" text-anchor="end">${formatValue(yMax * fraction)}</text>`);
  }
  const lastCount = data.game_count_by_turn.at(-1);
  parts.push(`<text x="${PAD.left}" y="${H - 4}" class="axis">turn ${turns[0]} (n=${data.game_count_by_turn[0]})</text>`);
  parts.push(`<text x="${W - PAD.right}" y="${H - 4}" class="axis" text-anchor="end">turn ${turns.at(-1)} (n=${lastCount})</text>`);

  if (show.confidenceBand) {
    perSeat.forEach((seatSeries, seat) => {
      const upper = seatSeries.ci_high.map((value, i) => `${xAt(i)},${yAt(value)}`);
      const lower = seatSeries.ci_low.map((value, i) => `${xAt(i)},${yAt(value)}`).reverse();
      parts.push(`<polygon points="${upper.join(" ")} ${lower.join(" ")}" fill="${COLORS[seat]}"
        fill-opacity="0.14" stroke="none"/>`);
    });
  }
  if (show.individualGames) {
    perSeat.forEach((seatSeries, seat) => {
      for (const gameValues of seatSeries.games) {
        const points = gameValues.map((value, i) => `${xAt(i)},${yAt(value)}`).join(" ");
        parts.push(`<polyline points="${points}" fill="none" stroke="${COLORS[seat]}"
          stroke-opacity="0.3" stroke-width="1"/>`);
      }
    });
  }
  if (show.minMaxEnvelope) {
    perSeat.forEach((seatSeries, seat) => {
      for (const bound of [seatSeries.min, seatSeries.max]) {
        const points = bound.map((value, i) => `${xAt(i)},${yAt(value)}`).join(" ");
        parts.push(`<polyline points="${points}" fill="none" stroke="${COLORS[seat]}"
          stroke-opacity="0.65" stroke-width="1" stroke-dasharray="2 2"/>`);
      }
    });
  }
  if (show.tInterval) {
    perSeat.forEach((seatSeries, seat) => {
      for (const bound of [seatSeries.t_low, seatSeries.t_high]) {
        const points = bound.map((value, i) => `${xAt(i)},${yAt(value)}`).join(" ");
        parts.push(`<polyline points="${points}" fill="none" stroke="${COLORS[seat]}"
          stroke-opacity="0.8" stroke-width="1.3" stroke-dasharray="6 3"/>`);
      }
    });
  }
  perSeat.forEach((seatSeries, seat) => {
    const points = seatSeries.mean.map((value, i) => `${xAt(i)},${yAt(value)}`).join(" ");
    parts.push(`<polyline points="${points}" fill="none" stroke="${COLORS[seat]}" stroke-width="2"
      stroke-linecap="round" stroke-linejoin="round"/>`);
    const lastIndex = seatSeries.mean.length - 1;
    if (lastIndex >= 0) parts.push(`<circle cx="${xAt(lastIndex)}" cy="${yAt(seatSeries.mean[lastIndex])}" r="4"
      fill="${COLORS[seat]}" stroke="#fbfaf6" stroke-width="2"/>`);
  });

  const chart = document.createElement("div");
  chart.className = "chart";
  chart.innerHTML = `<h4>${title}</h4><svg viewBox="0 0 ${W} ${H}">${parts.join("")}</svg>`;
  return chart;
}

// theme accents for the call-type stack; models reuse the seat palette via callerColor
const TOKEN_COLORS = { negotiation: "#2e7cb0", decision: "#1f8a5b", commentary: "#c99a2e", other: "#8b8472" };
const fmtTokens = n =>
  n >= 1e6 ? (n / 1e6).toFixed(1) + "M" : n >= 1e3 ? Math.round(n / 1e3) + "k" : String(Math.round(n));
const callerColor = caller => {
  const seat = latestData ? latestData.players.indexOf(caller) : -1;
  return seat >= 0 ? COLORS[seat] : "#8b8472";  // commentators (and any stray caller) read neutral grey
};

function renderTokenChart() {
  if (!latestData) return;
  const container = el("tokenChart");
  const usage = latestData.per_turn_usage;
  container.innerHTML = usage?.turns.length ? "" : '<div class="note">No traced API calls yet.</div>';
  if (usage?.turns.length) container.appendChild(buildTokenChart(usage));
}
for (const id of ["tokMeasure", "tokBreakdown"]) el(id).addEventListener("change", renderTokenChart);

// One stacked bar per turn for input (left) and output (right). The toggles pick the
// measure (tokens or estimated cost) and the stack dimension (call type, or by model).
function buildTokenChart(usage) {
  const measure = el("tokMeasure").value, byModel = el("tokBreakdown").value === "model";
  const groups = byModel ? usage.callers : usage.categories;
  const series = byModel ? usage.by_caller : usage.by_category;
  const [leftKey, rightKey] = measure === "cost" ? ["input_cost", "output_cost"] : ["input_tokens", "output_tokens"];
  const colorFor = byModel ? callerColor : (group => TOKEN_COLORS[group] ?? "#8b8472");
  const fmt = measure === "cost" ? (v => "$" + v.toFixed(2)) : fmtTokens;
  const value = (group, key, i) => series[group]?.[key]?.[i] ?? 0;
  const W = 1060, H = 250, PAD = { left: 54, right: 12, top: 14, bottom: 22 };
  const turns = usage.turns;
  const chart = document.createElement("div");
  chart.className = "chart";
  const legend = groups.map(group => `<span style="color:${colorFor(group)}">■</span> ${group}`).join(" &nbsp; ");
  const stackTotal = (key, i) => groups.reduce((sum, group) => sum + value(group, key, i), 0);
  let dataMax = 0;
  turns.forEach((_, i) => dataMax = Math.max(dataMax, stackTotal(leftKey, i), stackTotal(rightKey, i)));
  dataMax = dataMax || 1;
  const plotW = W - PAD.left - PAD.right, plotH = H - PAD.top - PAD.bottom;
  const yAt = v => H - PAD.bottom - (v / dataMax) * plotH;
  const slot = plotW / turns.length, barW = Math.min(24, Math.max(0.8, slot * 0.4));
  const parts = [];
  for (const fraction of [0, 0.5, 1]) {
    const gy = yAt(dataMax * fraction);
    parts.push(`<line x1="${PAD.left}" y1="${gy}" x2="${W - PAD.right}" y2="${gy}" stroke="${GRID}"/>`);
    parts.push(`<text x="${PAD.left - 4}" y="${gy + 3}" class="axis" text-anchor="end">${fmt(dataMax * fraction)}</text>`);
  }
  parts.push(`<text x="${PAD.left}" y="${H - 5}" class="axis">turn ${turns[0]}</text>`);
  parts.push(`<text x="${W - PAD.right}" y="${H - 5}" class="axis" text-anchor="end">turn ${turns.at(-1)}</text>`);
  const stack = (key, x, i) => {
    let base = 0;
    for (const group of groups) {
      const v = value(group, key, i);
      if (v > 0) {
        // segments above the first give up 1px to a hairline of surface, so the stack reads as segments
        const top = yAt(base + v), height = Math.max(0, yAt(base) - top - (base > 0 ? 1 : 0));
        parts.push(`<rect x="${x.toFixed(2)}" y="${top.toFixed(2)}" width="${barW.toFixed(2)}" height="${height.toFixed(2)}"
          fill="${colorFor(group)}"><title>turn ${turns[i]} · ${key.startsWith("input") ? "input" : "output"} · ${group}: ${fmt(v)}</title></rect>`);
      }
      base += v;
    }
  };
  turns.forEach((_, i) => {
    const x0 = PAD.left + i * slot;
    stack(leftKey, x0 + slot * 0.08, i);
    stack(rightKey, x0 + slot * 0.52, i);
  });
  chart.innerHTML = `<div class="tokenLegend">${legend}</div><svg viewBox="0 0 ${W} ${H}">${parts.join("")}</svg>`;
  return chart;
}

function renderAggregateTable(data) {
  const rows = data.table.map((row, seat) => {
    const interval = `${Math.round(row.win_rate_low * 100)}–${Math.round(row.win_rate_high * 100)}%`;
    const cost = row.cost_usd == null ? "—" : `$${row.cost_usd.toFixed(2)}`;
    return `<tr><td style="white-space:nowrap"><span class="swatch" style="background:${COLORS[seat]};display:inline-block;margin-right:7px"></span><span style="font-weight:600">${row.name}</span></td>
      <td class="num">${row.wins} / ${row.finished_games}</td>
      <td class="num">${row.finished_games ? interval : "—"}</td>
      <td class="num">${row.attacks}</td><td class="num">${row.conquests}</td>
      <td class="num">${row.armies_destroyed} / ${row.armies_lost}</td>
      <td class="num">${row.public_messages} 📢 ${row.private_messages} 🔒</td>
      <td class="num">${row.input_tokens.toLocaleString("en-US")} / ${row.output_tokens.toLocaleString("en-US")}</td>
      <td class="num">${cost}</td></tr>`;
  });
  el("aggregateTable").innerHTML = `<thead><tr><th>player</th><th>wins</th><th>win rate 95% CI</th>
    <th>attacks</th><th>conquests</th><th>destroyed / lost</th><th>messages</th>
    <th>tokens in / out</th><th>est. cost</th></tr></thead>
    <tbody>${rows.join("")}</tbody>`;
}

render(DATA);
el('tournamentContinueForm').addEventListener('submit', continueTournament);
el('tournamentReplayForm').addEventListener('submit', replayTournamentGame);
el('tournamentReplayGame').addEventListener('change', () => renderTournamentReplay(latestData));
if (POLL_URL) initTournamentEvaluations();
// Evaluations can finish or be rerun after the games end. Avoid overlapping rebuilds.
async function refreshTournament() {
  try {
    await fetchTournamentVersion();
  } catch { /* Keep the last complete report during a transient failure. */ }
  finally { setTimeout(refreshTournament, 5000); }
}
if (POLL_URL) setTimeout(refreshTournament, 5000);
</script>
</body>
</html>
