<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>risk-bench tournament</title>
<style>
  :root { --bg:#f6f6f4; --panel:#ffffff; --line:#e3e2de; --ink:#1f2329; --dim:#6e747d; --accent:#44546a;
          --sans: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif; }
  * { box-sizing: border-box; }
  body { margin:0; background:var(--bg); color:var(--ink); font:13px/1.55 var(--sans); }
  .wrap { max-width: 1100px; margin: 0 auto; padding: 28px 16px; }
  h1 { font: 700 20px var(--sans); margin: 0 0 4px; letter-spacing:-.01em; }
  .subtitle { color: var(--dim); margin-bottom: 18px; }
  .subtitle a { color: var(--accent); }
  h2 { font: 600 12px var(--sans); text-transform: uppercase; letter-spacing: .1em; color: var(--dim);
       margin: 26px 0 10px; border-bottom: 1px solid var(--line); padding-bottom: 5px; }
  .panel { background: var(--panel); border: 1px solid var(--line); border-radius: 6px; padding: 12px 14px; }
  #legend span { margin-right: 14px; font-weight: 600; }
  .status { font-size:11px; padding:1px 8px; border-radius:9px; white-space:nowrap; display:inline-block; }
  .status.live { background:#e2efe1; color:#2e6b34; animation: runningPulse 1.4s ease-in-out infinite; }
  @keyframes runningPulse { 50% { opacity:.45; } }
  .status.done { background:#ececea; color:var(--dim); }
  .status.paused { background:#f5ecd2; color:#8a6d1f; }
  .winner { color:#2e6b34; font-weight:600; }
  table { width:100%; border-collapse:collapse; }
  th { text-align:left; color:var(--dim); font-weight:600; font-size:10px; text-transform:uppercase;
       letter-spacing:.07em; padding:5px 8px; border-bottom:1.5px solid #c9c8c3; }
  td { padding:6px 8px; border-bottom:1px solid var(--line); vertical-align:top; }
  tr:last-child td { border-bottom:none; }
  tr.game { cursor:pointer; }
  tr.game:hover td { background:#f0efec; }
  .note { color:var(--dim); font-size:12px; margin: 0 0 12px; }
  .controls { display:flex; flex-wrap:wrap; gap:16px; margin:0 0 14px; font-size:12px; }
  .controls label { display:inline-flex; align-items:center; gap:5px; cursor:pointer; user-select:none; }
  .controls input { accent-color: var(--accent); }
  #charts { display:grid; grid-template-columns:1fr 1fr; gap:14px; }
  .chart h4 { margin:0 0 4px; font:600 10px var(--sans); text-transform:uppercase; letter-spacing:.08em;
              color:var(--dim); }
  .tokenLegend { font-size:11px; color:var(--dim); margin:0 0 4px; }
  .tokenLegend span { font-weight:700; }
  .tokenControls { display:flex; gap:14px; margin:0 0 10px; font-size:12px; }
  .tokenControls label { color:var(--dim); }
  .chart svg { width:100%; height:auto; background:#fcfcfb; border:1px solid var(--line); border-radius:4px; }
  .chart text.axis { font:9px var(--sans); fill:var(--dim); }
  .tag { display:inline-block; font-size:10px; color:var(--accent); background:#e8ecf1;
         border:1px solid #d4dae2; border-radius:3px; padding:0 5px; margin:1px 3px 1px 0; }
  td.num { white-space:nowrap; }
</style>
</head>
<body>
<div class="wrap">
  <h1>🏆 Tournament <span id="tournamentId"></span></h1>
  <div class="subtitle"><a href="/">← all games</a> · <span id="liveNote"></span></div>
  <div id="legend"></div>

  <h2>Games</h2>
  <div class="panel"><table id="gamesTable"></table></div>

  <h2>Cross-game statistics</h2>
  <div class="note">Bold line: mean across the games still running at each turn. Shaded band: 95% bootstrap
    confidence interval for that mean — how well the average is pinned down; it widens late-game as games
    finish and fewer remain. Dashed lines: the parametric 95% Student-t interval for the same mean, an
    alternative to the bootstrap band kept for side-by-side comparison (it can run wider than the data at
    very small samples). Dotted lines: the min–max envelope, i.e. the extreme games at each turn (a spread,
    not a confidence statement). Thin lines: the individual games. The win-rate intervals in the table
    below are Wilson 95% score intervals, valid at any sample size.</div>
  <div class="controls">
    <label><input type="checkbox" id="toggleCi" checked> 95% bootstrap band</label>
    <label><input type="checkbox" id="toggleT"> 95% t-interval</label>
    <label><input type="checkbox" id="toggleMinMax"> min–max envelope</label>
    <label><input type="checkbox" id="toggleGames" checked> individual games</label>
  </div>
  <div id="charts"></div>

  <h2>API usage per turn</h2>
  <div class="note">Mean per turn across the games. Each turn shows two bars: input (the prompt sent) on the
    left, output (the model's response) on the right. Switch between token counts and estimated cost, and
    between stacking by call type or by model.</div>
  <div class="tokenControls">
    <label>measure
      <select id="tokMeasure"><option value="tokens">tokens</option><option value="cost">cost ($)</option></select></label>
    <label>breakdown
      <select id="tokBreakdown"><option value="all">all (by call type)</option><option value="model">by model</option></select></label>
  </div>
  <div id="tokenChart"></div>

  <h2>Aggregates across all games</h2>
  <div class="panel"><table id="aggregateTable"></table></div>
</div>
<script>
const DATA = {{ tournament_json }};
const LIVE = {{ live_json }};
const POLL_URL = {{ poll_url_json }};
const COLORS = ["#a33f3b","#3c6c9e","#6e8f3a","#6b5288","#c97a29","#2f8a9e"];
const el = id => document.getElementById(id);
const escapeHtml = text => text.replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;");

const METRICS = [
  ["army share", "army_share", v => Math.round(v * 100) + "%"],
  ["territories", "territories", v => Math.round(v)],
  ["income per turn", "income", v => Math.round(v)],
  ["cards in hand", "cards", v => Math.round(v)],
  ["skill: strong play, cumulative", "skill_strong", v => Math.round(v)],
  ["skill: weak play, cumulative", "skill_weak", v => Math.round(v)],
  ["conduct: cooperative, cumulative", "conduct_cooperative", v => Math.round(v)],
  ["conduct: adversarial, cumulative", "conduct_adversarial", v => Math.round(v)],
  ["conduct: deception, cumulative", "conduct_deceptive", v => Math.round(v)],
];

let latestData = null;

function render(data) {
  latestData = data;
  el("tournamentId").textContent = data.id;
  el("liveNote").textContent = data.games.every(game => game.finished)
    ? `${data.games.length} games, all finished` : `${data.games.length} games — LIVE, updating`;
  el("legend").innerHTML = data.players
    .map((name, seat) => `<span style="color:${COLORS[seat]}">${name}</span>`).join("");
  renderGamesTable(data);
  drawCharts();
  renderTokenChart();
  renderAggregateTable(data);
}

function drawCharts() {
  if (!latestData) return;
  const show = {
    confidenceBand: el("toggleCi").checked,
    tInterval: el("toggleT").checked,
    minMaxEnvelope: el("toggleMinMax").checked,
    individualGames: el("toggleGames").checked,
  };
  const charts = el("charts");
  charts.innerHTML = "";
  for (const [title, metric, formatValue] of METRICS) {
    charts.appendChild(buildChart(latestData, title, metric, formatValue, show));
  }
}

for (const toggleId of ["toggleCi", "toggleT", "toggleMinMax", "toggleGames"]) {
  el(toggleId).addEventListener("change", drawCharts);
}

function renderGamesTable(data) {
  const rows = data.games.map(game => {
    const status = game.finished
      ? '<span class="status done">finished</span>' : '<span class="status live">● in progress</span>';
    const winner = game.winner ? `<span class="winner">${game.winner}</span>` : (game.finished ? "draw" : "—");
    const cost = game.cost_usd == null ? "—" : `$${game.cost_usd.toFixed(2)}`;
    return `<tr class="game" onclick="location.href='/games/${game.id}'">
      <td>${game.id}</td><td class="num">seed ${game.seed}</td><td>${status}</td>
      <td>${winner}</td><td class="num">${game.turn_count}</td><td class="num">${cost}</td></tr>`;
  });
  el("gamesTable").innerHTML = `<thead><tr><th>game</th><th>seed</th><th>status</th><th>winner</th>
    <th>turn</th><th>est. cost</th></tr></thead><tbody>${rows.join("")}</tbody>`;
}

function buildChart(data, title, metric, formatValue, show) {
  const W = 470, H = 240, PAD = { left: 38, right: 12, top: 14, bottom: 18 };
  const turns = data.turns;
  const perSeat = data.metrics[metric];
  const dataMax = Math.max(...perSeat.map(seat => Math.max(...seat.max))) || 1;
  const integerValued = perSeat.every(seat => seat.games.flat().every(Number.isInteger));
  const yMax = integerValued ? Math.max(2, Math.ceil(dataMax / 2) * 2) : dataMax;
  const xAt = i => PAD.left + (turns.length < 2 ? 0 : i * (W - PAD.left - PAD.right) / (turns.length - 1));
  const yAt = v => H - PAD.bottom - (v / yMax) * (H - PAD.top - PAD.bottom);
  const parts = [];

  for (const fraction of [0, 0.5, 1]) {
    const gy = yAt(yMax * fraction);
    parts.push(`<line x1="${PAD.left}" y1="${gy}" x2="${W - PAD.right}" y2="${gy}" stroke="#e8e7e3"/>`);
    parts.push(`<text x="${PAD.left - 4}" y="${gy + 3}" class="axis" text-anchor="end">${formatValue(yMax * fraction)}</text>`);
  }
  const lastCount = data.game_count_by_turn.at(-1);
  parts.push(`<text x="${PAD.left}" y="${H - 4}" class="axis">turn ${turns[0]} (n=${data.game_count_by_turn[0]})</text>`);
  parts.push(`<text x="${W - PAD.right}" y="${H - 4}" class="axis" text-anchor="end">turn ${turns.at(-1)} (n=${lastCount})</text>`);

  if (show.confidenceBand) {
    perSeat.forEach((seatSeries, seat) => {
      const upper = seatSeries.ci_high.map((value, i) => `${xAt(i)},${yAt(value)}`);
      const lower = seatSeries.ci_low.map((value, i) => `${xAt(i)},${yAt(value)}`).reverse();
      parts.push(`<polygon points="${upper.join(" ")} ${lower.join(" ")}" fill="${COLORS[seat]}"
        fill-opacity="0.14" stroke="none"/>`);
    });
  }
  if (show.individualGames) {
    perSeat.forEach((seatSeries, seat) => {
      for (const gameValues of seatSeries.games) {
        const points = gameValues.map((value, i) => `${xAt(i)},${yAt(value)}`).join(" ");
        parts.push(`<polyline points="${points}" fill="none" stroke="${COLORS[seat]}"
          stroke-opacity="0.3" stroke-width="1"/>`);
      }
    });
  }
  if (show.minMaxEnvelope) {
    perSeat.forEach((seatSeries, seat) => {
      for (const bound of [seatSeries.min, seatSeries.max]) {
        const points = bound.map((value, i) => `${xAt(i)},${yAt(value)}`).join(" ");
        parts.push(`<polyline points="${points}" fill="none" stroke="${COLORS[seat]}"
          stroke-opacity="0.65" stroke-width="1" stroke-dasharray="2 2"/>`);
      }
    });
  }
  if (show.tInterval) {
    perSeat.forEach((seatSeries, seat) => {
      for (const bound of [seatSeries.t_low, seatSeries.t_high]) {
        const points = bound.map((value, i) => `${xAt(i)},${yAt(value)}`).join(" ");
        parts.push(`<polyline points="${points}" fill="none" stroke="${COLORS[seat]}"
          stroke-opacity="0.8" stroke-width="1.3" stroke-dasharray="6 3"/>`);
      }
    });
  }
  perSeat.forEach((seatSeries, seat) => {
    const points = seatSeries.mean.map((value, i) => `${xAt(i)},${yAt(value)}`).join(" ");
    parts.push(`<polyline points="${points}" fill="none" stroke="${COLORS[seat]}" stroke-width="2.2"/>`);
  });

  const chart = document.createElement("div");
  chart.className = "chart";
  chart.innerHTML = `<h4>${title}</h4><svg viewBox="0 0 ${W} ${H}">${parts.join("")}</svg>`;
  return chart;
}

const TOKEN_COLORS = { negotiation: "#3c6c9e", decision: "#6e8f3a", commentary: "#c97a29", other: "#9a8aa0" };
const fmtTokens = n =>
  n >= 1e6 ? (n / 1e6).toFixed(1) + "M" : n >= 1e3 ? Math.round(n / 1e3) + "k" : String(Math.round(n));
const callerColor = caller => {
  const seat = latestData ? latestData.players.indexOf(caller) : -1;
  return seat >= 0 ? COLORS[seat] : "#8a8f98";  // commentators (and any stray caller) read neutral grey
};

function renderTokenChart() {
  if (!latestData) return;
  const container = el("tokenChart");
  const usage = latestData.per_turn_usage;
  container.innerHTML = usage?.turns.length ? "" : '<div class="note">No traced API calls yet.</div>';
  if (usage?.turns.length) container.appendChild(buildTokenChart(usage));
}
for (const id of ["tokMeasure", "tokBreakdown"]) el(id).addEventListener("change", renderTokenChart);

// One stacked bar per turn for input (left) and output (right). The toggles pick the
// measure (tokens or estimated cost) and the stack dimension (call type, or by model).
function buildTokenChart(usage) {
  const measure = el("tokMeasure").value, byModel = el("tokBreakdown").value === "model";
  const groups = byModel ? usage.callers : usage.categories;
  const series = byModel ? usage.by_caller : usage.by_category;
  const [leftKey, rightKey] = measure === "cost" ? ["input_cost", "output_cost"] : ["input_tokens", "output_tokens"];
  const colorFor = byModel ? callerColor : (group => TOKEN_COLORS[group] ?? "#888");
  const fmt = measure === "cost" ? (v => "$" + v.toFixed(2)) : fmtTokens;
  const value = (group, key, i) => series[group]?.[key]?.[i] ?? 0;
  const W = 1060, H = 250, PAD = { left: 54, right: 12, top: 14, bottom: 22 };
  const turns = usage.turns;
  const chart = document.createElement("div");
  chart.className = "chart";
  const legend = groups.map(group => `<span style="color:${colorFor(group)}">■</span> ${group}`).join(" &nbsp; ");
  const stackTotal = (key, i) => groups.reduce((sum, group) => sum + value(group, key, i), 0);
  let dataMax = 0;
  turns.forEach((_, i) => dataMax = Math.max(dataMax, stackTotal(leftKey, i), stackTotal(rightKey, i)));
  dataMax = dataMax || 1;
  const plotW = W - PAD.left - PAD.right, plotH = H - PAD.top - PAD.bottom;
  const yAt = v => H - PAD.bottom - (v / dataMax) * plotH;
  const slot = plotW / turns.length, barW = Math.max(0.8, slot * 0.4);
  const parts = [];
  for (const fraction of [0, 0.5, 1]) {
    const gy = yAt(dataMax * fraction);
    parts.push(`<line x1="${PAD.left}" y1="${gy}" x2="${W - PAD.right}" y2="${gy}" stroke="#e8e7e3"/>`);
    parts.push(`<text x="${PAD.left - 4}" y="${gy + 3}" class="axis" text-anchor="end">${fmt(dataMax * fraction)}</text>`);
  }
  parts.push(`<text x="${PAD.left}" y="${H - 5}" class="axis">turn ${turns[0]}</text>`);
  parts.push(`<text x="${W - PAD.right}" y="${H - 5}" class="axis" text-anchor="end">turn ${turns.at(-1)}</text>`);
  const stack = (key, x, i) => {
    let base = 0;
    for (const group of groups) {
      const v = value(group, key, i);
      if (v > 0) {
        const top = yAt(base + v), height = Math.max(0, yAt(base) - top);
        parts.push(`<rect x="${x.toFixed(2)}" y="${top.toFixed(2)}" width="${barW.toFixed(2)}" height="${height.toFixed(2)}"
          fill="${colorFor(group)}"><title>turn ${turns[i]} · ${key.startsWith("input") ? "input" : "output"} · ${group}: ${fmt(v)}</title></rect>`);
      }
      base += v;
    }
  };
  turns.forEach((_, i) => {
    const x0 = PAD.left + i * slot;
    stack(leftKey, x0 + slot * 0.08, i);
    stack(rightKey, x0 + slot * 0.52, i);
  });
  chart.innerHTML = `<div class="tokenLegend">${legend}</div><svg viewBox="0 0 ${W} ${H}">${parts.join("")}</svg>`;
  return chart;
}

function renderAggregateTable(data) {
  const rows = data.table.map((row, seat) => {
    const interval = `${Math.round(row.win_rate_low * 100)}–${Math.round(row.win_rate_high * 100)}%`;
    const tags = Object.entries(row.tags).sort((a, b) => b[1] - a[1])
      .map(([behavior, count]) => `<span class="tag">${behavior}${count > 1 ? ` ×${count}` : ""}</span>`).join("");
    const cost = row.cost_usd == null ? "—" : `$${row.cost_usd.toFixed(2)}`;
    return `<tr><td style="color:${COLORS[seat]};font-weight:700">${row.name}</td>
      <td class="num">${row.wins} / ${row.finished_games}</td>
      <td class="num">${row.finished_games ? interval : "—"}</td>
      <td class="num">${row.attacks}</td><td class="num">${row.conquests}</td>
      <td class="num">${row.armies_destroyed} / ${row.armies_lost}</td>
      <td class="num">${row.public_messages} 📢 ${row.private_messages} 🔒</td>
      <td class="num">${row.input_tokens.toLocaleString("en-US")} / ${row.output_tokens.toLocaleString("en-US")}</td>
      <td class="num">${cost}</td><td>${tags || "—"}</td></tr>`;
  });
  el("aggregateTable").innerHTML = `<thead><tr><th>player</th><th>wins</th><th>win rate 95% CI</th>
    <th>attacks</th><th>conquests</th><th>destroyed / lost</th><th>messages</th>
    <th>tokens in / out</th><th>est. cost</th><th>behavior tags</th></tr></thead>
    <tbody>${rows.join("")}</tbody>`;
}

render(DATA);
if (LIVE) setInterval(async () => {
  const response = await fetch(POLL_URL, { cache: "no-store" });
  if (response.ok) render(await response.json());
}, 3000);
</script>
</body>
</html>
